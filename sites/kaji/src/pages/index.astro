---
import "../styles/global.css";
import { smiths } from "../data/smiths";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KAJI — 鍛冶 · Hand-forged Japanese kitchen knives</title>
    <meta name="description" content="Hand-forged kitchen knives by the ninth generation of a Sakai swordsmith lineage. One smith, one blade — from raw steel to finished edge." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,400&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>

    <header class="site-header">
      <a class="brand" href="/">
        <span class="mark jp">鍛冶</span>
        <span class="word">Kaji</span>
      </a>
      <nav class="nav-links">
        <a href="#collection">Knives</a>
        <a href="#smiths">Smiths</a>
        <a href="#lineage">Lineage</a>
        <a href="#process">Forging</a>
        <a href="#commission">Commission</a>
      </nav>
    </header>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-media"><img src="/hero-01.png" alt="A hand-forged kasumi gyuto resting on dark slate" /></div>
      <div class="hero-light" aria-hidden="true"></div>
      <span class="hero-vert jp">鍛冶 — 一鍛一刀</span>
      <div class="hero-content container">
        <p class="eyebrow reveal" style="--i:0">Sakai · Est. 1782 · Ninth generation</p>
        <h1 class="reveal" style="--i:1">A blade is <em>patience</em><br />made visible.</h1>
        <p class="hero-sub reveal" style="--i:2">Hand-forged kitchen knives by the ninth generation of a Sakai swordsmith lineage — one smith, one blade, from raw steel to finished edge.</p>
        <div class="hero-meta reveal" style="--i:3">
          <span>Steel <b>Aogami #2</b></span>
          <span>Finish <b>Kasumi</b></span>
          <span>Edge <b>63 HRC</b></span>
          <span>Made <b>Osaka, JP</b></span>
        </div>
      </div>
      <div class="scroll-cue">Scroll</div>
    </section>

    <!-- MANIFESTO -->
    <section class="manifesto">
      <span class="manifesto-vert jp" aria-hidden="true">鍛えて、研ぐ</span>
      <div class="container">
        <p class="manifesto-lead reveal">We do not <span class="accent">manufacture</span>. A knife leaves this atelier only when a single smith has carried it from raw bar to finished edge — often across forty hours and four days of fire.</p>
        <div class="manifesto-body">
          <p class="reveal" style="--i:0">Our forebears made swords for the daimyō of Settsu. When the age of the blade ended in 1876, the same hands turned to the kitchen — and the same discipline followed the steel from the battlefield to the cutting board.</p>
          <p class="reveal" style="--i:1">Every blade is water-quenched by eye, its <em>hamon</em> drawn in clay and revealed only by the stone. No two are identical, because no two moments at the fire ever are. What you buy is not a product. It is a decision made permanent.</p>
        </div>
      </div>
    </section>

    <!-- LINEAGE -->
    <section class="lineage" id="lineage">
      <div class="lineage-grid">
        <div class="lineage-media"><img src="/forge.png" alt="A bladesmith hammering glowing steel in a dark forge" /></div>
        <div class="lineage-text">
          <p class="eyebrow reveal">The lineage · 系譜</p>
          <h2 class="reveal" style="--i:1">From <em>swords</em><br />to the supper table.</h2>
          <blockquote class="pullquote reveal" style="--i:2">"The sword defends one life. The kitchen knife serves ten thousand meals. The harder task is the second."</blockquote>
          <p class="reveal" style="--i:3">The ninth-generation smith, Naoki Munetsugu, trained eleven years under his father before he was permitted to sign a single blade. Today he forges fewer than three hundred knives a year, each stamped with the family <em>mei</em>.</p>
          <div class="lineage-stats reveal" style="--i:4">
            <div class="stat"><span class="num">1782</span><span class="lab">Founded, Sakai</span></div>
            <div class="stat"><span class="num">IX</span><span class="lab">Generation</span></div>
            <div class="stat"><span class="num">40h</span><span class="lab">Per blade</span></div>
            <span class="hanko jp" aria-hidden="true">宗次</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SMITHS -->
    <section class="smiths" id="smiths">
      <div class="container">
        <div class="smiths-head">
          <div>
            <p class="eyebrow reveal">The smiths · 三人の鍛冶</p>
            <h2 class="reveal" style="--i:1; margin-top: var(--s3)">Three hands,<br />one <em>fire</em>.</h2>
          </div>
          <p class="reveal" style="--i:2">Every Munetsugu blade is carried start to finish by one of three smiths. Learn whose hands made yours — each signs with their own mei.</p>
        </div>
        <div class="smiths-grid">
          {smiths.map((s, i) => (
            <a class="smith-card reveal" style={`--i:${i}`} href={`/smith/${s.slug}/`}>
              <div class="smith-figure">
                <img src={s.portrait} alt={`${s.nameEn}, ${s.role.toLowerCase()} at Munetsugu Hamono`} loading="lazy" />
                <span class="smith-name-vert jp" aria-hidden="true">{s.nameJp}</span>
                <div class="smith-overlay">
                  <div class="role">{s.role} · {s.generation}</div>
                  <div class="name">{s.nameEn}</div>
                  <div class="spec">{s.specialty}</div>
                </div>
              </div>
              <div class="smith-meta">
                <span class="q">“{s.quote}”</span>
                <span class="go">Meet →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- COLLECTION -->
    <section class="collection" id="collection">
      <div class="container">
        <div class="collection-head">
          <h2 class="reveal">Three shapes,<br />ten thousand meals.</h2>
          <p class="reveal" style="--i:1">Each blade is offered in a limited annual run. We forge to a waiting list; a commission today is delivered in the following season.</p>
        </div>
        <div class="collection-grid">
          <article class="knife-card reveal" style="--i:0">
            <div class="knife-figure">
              <span class="knife-index">01 / 03</span>
              <span class="knife-tag">Made to order</span>
              <img src="/gyuto.png" alt="Gyuto chef's knife" />
            </div>
            <div class="knife-info">
              <div class="knife-name"><span class="jp">牛刀</span><span class="en">Gyuto · 240mm</span></div>
              <div class="knife-spec">Aogami #2<br />Kasumi<br />63 HRC</div>
            </div>
            <div class="knife-price" style="margin-top:8px">¥68,000</div>
            <a class="forged-by" href="/smith/naoki/">Forged by Naoki Munetsugu</a>
          </article>
          <article class="knife-card reveal" style="--i:1">
            <div class="knife-figure">
              <span class="knife-index">02 / 03</span>
              <span class="knife-tag">Made to order</span>
              <img src="/santoku.png" alt="Santoku knife" />
            </div>
            <div class="knife-info">
              <div class="knife-name"><span class="jp">三徳</span><span class="en">Santoku · 180mm</span></div>
              <div class="knife-spec">Shirogami #1<br />Kasumi<br />62 HRC</div>
            </div>
            <div class="knife-price" style="margin-top:8px">¥54,000</div>
            <a class="forged-by" href="/smith/rin/">Forged by Rin Munetsugu</a>
          </article>
          <article class="knife-card reveal" style="--i:2">
            <div class="knife-figure">
              <span class="knife-index">03 / 03</span>
              <span class="knife-tag">Made to order</span>
              <img src="/nakiri.png" alt="Nakiri vegetable knife" />
            </div>
            <div class="knife-info">
              <div class="knife-name"><span class="jp">菜切</span><span class="en">Nakiri · 165mm</span></div>
              <div class="knife-spec">Shirogami #2<br />Kurouchi<br />61 HRC</div>
            </div>
            <div class="knife-price" style="margin-top:8px">¥49,000</div>
            <a class="forged-by" href="/smith/goro/">Forged by Goro Tanabe</a>
          </article>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="process" id="process">
      <svg class="hamon-divider" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="echo" d="M0,60 C120,20 200,100 320,60 C440,20 520,100 640,60 C760,20 840,100 960,60 C1080,20 1160,100 1280,60 C1360,35 1400,70 1440,60" />
        <path d="M0,60 C120,20 200,100 320,60 C440,20 520,100 640,60 C760,20 840,100 960,60 C1080,20 1160,100 1280,60 C1360,35 1400,70 1440,60" />
      </svg>
      <div class="container">
        <div class="process-head">
          <p class="eyebrow reveal" style="justify-content:center">The forging · 鍛錬</p>
          <h2 class="reveal" style="--i:1">Four days at the fire, five acts of the hand.</h2>
        </div>
        <div class="process-steps">
          <div class="step reveal" style="--i:0" data-ghost="壱"><span class="n">01</span><h3 class="jp">鋼</h3><div class="en">Hagane · Steel</div><p>A single bar of carbon steel is chosen by ear and eye — its song under the hammer tells the smith what it will become.</p></div>
          <div class="step reveal" style="--i:1" data-ghost="弐"><span class="n">02</span><h3 class="jp">鍛錬</h3><div class="en">Tanren · Forging</div><p>Hard edge steel is forge-welded to a softer jacket and drawn out under repeated blows, aligning the grain.</p></div>
          <div class="step reveal" style="--i:2" data-ghost="参"><span class="n">03</span><h3 class="jp">土置き</h3><div class="en">Tsuchioki · Clay</div><p>A clay slurry is painted along the spine. In the quench it holds the fire back, and the <em>hamon</em> is born.</p></div>
          <div class="step reveal" style="--i:3" data-ghost="肆"><span class="n">04</span><h3 class="jp">研ぎ</h3><div class="en">Togi · Sharpening</div><p>Across a dozen natural whetstones the kasumi haze rises, and the edge is taken below a single micron.</p></div>
          <div class="step reveal" style="--i:4" data-ghost="伍"><span class="n">05</span><h3 class="jp">柄付け</h3><div class="en">Etsuke · Handle</div><p>An octagonal ho-wood handle and buffalo-horn ferrule are fitted by hand, balanced to the blade's own weight.</p></div>
        </div>
      </div>
    </section>

    <!-- CRAFT / STEEL -->
    <section class="craft">
      <div class="craft-grid">
        <div class="craft-media">
          <img src="/steel-detail.png" alt="Macro of a kasumi blade surface showing the hamon" />
          <span class="media-chip">刃文 · Hamon — the temper line</span>
        </div>
        <div class="craft-text">
          <p class="eyebrow reveal">The steel · 鋼</p>
          <h2 class="reveal" style="--i:1">The soul is in the <em>steel</em>, and the steel remembers the water.</h2>
          <p class="reveal" style="--i:2">We forge in the two classic carbon steels of the Japanese kitchen. Each asks something different of the cook, and gives something different in return.</p>
          <div class="steel-table reveal" style="--i:3">
            <div class="steel-row"><span class="k jp">青紙二号</span><span class="v">Aogami #2 · blue paper</span><span class="r"><em>Retention</em><i class="meter"><b style="--w:82%"></b></i></span></div>
            <div class="steel-row"><span class="k jp">白紙一号</span><span class="v">Shirogami #1 · white paper</span><span class="r"><em>Sharpness</em><i class="meter"><b style="--w:96%"></b></i></span></div>
            <div class="steel-row"><span class="k jp">黒打ち</span><span class="v">Kurouchi · forge finish</span><span class="r"><em>Patina</em><i class="meter"><b style="--w:60%"></b></i></span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMMISSION -->
    <section class="commission" id="commission">
      <span class="jp-bg" aria-hidden="true">鍛</span>
      <p class="eyebrow reveal" style="justify-content:center; margin-bottom: var(--s4)">Commissions open · 2027 season</p>
      <h2 class="reveal" style="--i:1">Commission a blade<br />that outlives you.</h2>
      <p class="reveal" style="--i:2">Tell us how you cook, and Munetsugu will forge to your hand. Each commission opens a place on next season's list — never more than three hundred a year.</p>
      <a class="btn reveal" style="--i:3" href="#"><span>Begin a commission →</span></a>
      <p class="commission-note reveal" style="--i:4">Response within one week · Ships worldwide from Osaka</p>
    </section>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="mark jp">鍛冶</span>
            <p>Munetsugu Hamono · a Sakai bladesmith since 1782. Forged in Osaka, shipped worldwide.</p>
          </div>
          <div class="footer-col">
            <h4>Knives</h4>
            <a href="#collection">Gyuto</a><a href="#collection">Santoku</a><a href="#collection">Nakiri</a><a href="#collection">Petty</a>
          </div>
          <div class="footer-col">
            <h4>Atelier</h4>
            <a href="#lineage">The lineage</a><a href="#process">Forging</a><a href="#commission">Commission</a><a href="#">Care & sharpening</a>
          </div>
        </div>
        <div class="footer-base">
          <span><i class="seal" aria-hidden="true"></i>© 2026 Munetsugu Hamono</span>
          <span>一鍛一刀 · One fire, one blade</span>
          <span>Sakai · Osaka · JP</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.documentElement.classList.add("js");

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );
      document.querySelectorAll(".reveal, .hamon-divider").forEach((el) => io.observe(el));

      const hero = document.querySelector(".hero");
      const light = document.querySelector(".hero-light");
      if (hero && light) {
        hero.addEventListener("pointermove", (e) => {
          const r = hero.getBoundingClientRect();
          light.style.transform = `translate(${e.clientX - r.left - 260}px, ${e.clientY - r.top - 260}px)`;
        });
      }

      // header: transparent over the hero; solid bar once scrolled;
      // hides scrolling down, returns scrolling up.
      const header = document.querySelector(".site-header");
      let lastY = window.scrollY;
      const onScroll = () => {
        const y = window.scrollY;
        header.classList.toggle("scrolled", y > 60);
        if (y > 260 && y > lastY + 4) header.classList.add("hidden");
        else if (y < lastY - 4 || y <= 260) header.classList.remove("hidden");
        lastY = y;
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
