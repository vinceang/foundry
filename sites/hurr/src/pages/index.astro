---
import "@fontsource/amiri/400.css";
import "@fontsource/amiri/700.css";
import "@fontsource/barlow-semi-condensed/400.css";
import "@fontsource/barlow-semi-condensed/500.css";
import "../styles/global.css";

import { SPECIES as species, pattern } from "../lib/pattern.mjs";

// Server-render the default cut so the signature is a finished drawing before
// any script runs. Without this it was an empty box with JS off.
const d0 = species[0];
const P = pattern({ w: d0.w, h: d0.h, blockScale: d0.block, passage: false });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hurr — falconry furniture, Al Ain</title>
    <meta
      name="description"
      content="A four-bench workshop in Al Ain making hoods, gloves and jesses for falcons flown at first and last light. Every burqu' cut to one bird."
    />
    <script is:inline>
      addEventListener("DOMContentLoaded", () => {
      const rvIO = new IntersectionObserver(
        (es) => {
          for (const e of es)
            if (e.isIntersecting) {
              e.target.classList.add("in");
              rvIO.unobserve(e.target);
            }
        },
        { threshold: 0.16, rootMargin: "0px 0px -6% 0px" }
      );
      document.querySelectorAll(".rv, .rv-line").forEach((el) => rvIO.observe(el));
      });

      // Motion is opt-in. Without this class the composition is already
      // finished, so JS-off and reduced-motion both get the whole page.
      const q = new URLSearchParams(location.search);
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!q.has("nofx") && !reduced) document.documentElement.classList.add("fx");
      if (q.has("nofx")) document.documentElement.classList.add("nofx");
    </script>
  </head>

  <body>
    <a class="skip-link" href="#burqu">Skip to the hood</a>

    <header class="head" id="top">
      <a class="mark" href="#top">
        <span class="mark__ar" lang="ar">حر</span>
        <span class="mark__la">HURR</span>
      </a>
      <nav class="nav" aria-label="Sections">
        <a href="#burqu">The burqu&rsquo;</a>
        <a href="#commission">Commission</a>
      </nav>
    </header>

    <!-- I. First light -->
    <section class="hero" id="hero">
      <img
        class="hero__plate"
        src="/images/hero.webp"
        width="1600"
        height="893"
        alt="A saker falcon on a low wooden block on desert gravel at civil twilight, a rocky ridge low on the horizon behind."
        fetchpriority="high"
        decoding="async"
      />
      <div class="wrap">
        <p class="record">
          <span>Hurr</span><i aria-hidden="true">·</i>
          <span><b>1,012 g</b></span><i aria-hidden="true">·</i>
          <span>flown 17:42</span><i aria-hidden="true">·</i>
          <span>burqu&rsquo; size 4</span>
        </p>

        <h1 class="hero__line settle rv"><span class="rv-line"><span>Everything here is made</span></span><span class="rv-line" style="--d:1"><span>for a bird that could leave.</span></span></h1>

        <p class="hero__sub narrow settle">
          A falcon is not owned. It is flown free at first and last light, and
          it comes back, or it does not. Four benches in Al Ain, at the foot
          of Jebel Hafeet, making the equipment that daily consent requires.
        </p>
      </div>
    </section>

    <hr class="stitch wrap" />

    <!-- III. The burqu' — the signature -->
    <section class="burqu" id="burqu">
      <div class="wrap">
        <p class="record">
          <span>Pattern</span><i aria-hidden="true">·</i>
          <span>three-piece Arab hood</span><i aria-hidden="true">·</i>
          <span><b data-rd-size>size {P.spec.size}</b></span><i aria-hidden="true">·</i>
          <span data-rd-leather>{P.spec.leather} kid-lined goat</span>
        </p>

        <div class="burqu__head">
          <h2 class="burqu__title rv"><span class="rv-line"><span>Cut to one bird.</span></span></h2>
          <p class="burqu__lede narrow">
            A hood that does not fit is not a lesser object; it is a cruelty.
            So it is cut to the individual bird, measured across the head and
            from beak to crown, and shaped differently for a bird taken from
            the nest than for one caught wild. Enter yours. The pattern is
            drawn as a cutter would lay it, and this same panel places the
            order.
          </p>
        </div>

        <div class="burqu__grid">
          <!-- the drawing -->
          <figure class="pattern rv">
            <div class="pattern__frame">
            <svg
              class="pattern__svg"
              viewBox={P.vb}
              role="img"
              aria-labelledby="pattern-desc"
              data-pattern
            >
              <desc id="pattern-desc">
                The three flat pattern pieces of an Arab falcon hood, the
                centre block and two side panels, redrawn to the measurements
                entered beside them.
              </desc>

              <g class="pattern__paper">
                <path class="pc pc--panel" data-left d={P.left} />
                <path class="pc pc--panel" data-right d={P.right} />
                <path class="pc pc--block" data-block d={P.block} />
                <circle class="pc__socket" data-socket cx={P.socket.cx} cy={P.socket.cy} r="9" />
                <path class="pc__eye" data-eyeL d={P.eyeL} />
                <path class="pc__eye" data-eyeR d={P.eyeR} />
                <path class="pc__brace" data-brace d={P.brace} />
              </g>

              <g class="pattern__dims" data-dims>
                <line data-dimw x1={P.dimW.x1} y1={P.dimW.y} x2={P.dimW.x2} y2={P.dimW.y} />
                <line data-dimh x1={P.dimH.x} y1={P.dimH.y1} x2={P.dimH.x} y2={P.dimH.y2} />
              </g>
            </svg>
            <span class="pdim pdim--w" data-dimwt
                  style={`left:${P.dimW.pctX}%;top:${P.dimW.pctY}%`}>{P.dimW.label}</span>
            <span class="pdim pdim--h" data-dimht
                  style={`left:${P.dimH.pctX}%;top:${P.dimH.pctY}%`}>{P.dimH.label}</span>
            </div>
            <figcaption class="pattern__cap">
              <span data-cap-species>Hurr</span> ·&nbsp;<span data-cap-temper
              >nest-taken</span> · pieces shown flat,
              actual size <span data-cap-scale>1:1.6</span>
            </figcaption>
          </figure>

          <!-- the measurements, which are also the order -->
          <form class="fit" data-fit novalidate>
            <fieldset class="fit__set">
              <legend class="eyebrow">The bird</legend>

              <div class="fit__species" role="radiogroup" aria-label="Species">
                {species.map((s, i) => (
                  <label class="sp">
                    <input
                      type="radio"
                      name="species"
                      value={s.id}
                      data-w={s.w}
                      data-h={s.h}
                      data-block={s.block}
                      checked={i === 0}
                    />
                    <span class="sp__la">{s.label}</span>
                    <span class="sp__en">{s.en}</span>
                  </label>
                ))}
              </div>

              <label class="fit__row">
                <span class="fit__label">Across the head</span>
                <span class="fit__val"><output data-out-w>46</output> mm</span>
                <input type="range" name="w" min="38" max="52" step="1" value="46" data-w />
              </label>

              <label class="fit__row">
                <span class="fit__label">Beak to crown</span>
                <span class="fit__val"><output data-out-h>38</output> mm</span>
                <input type="range" name="h" min="30" max="46" step="1" value="38" data-h />
              </label>

              <div class="fit__temper" role="radiogroup" aria-label="How the bird was taken">
                <label class="tm">
                  <input type="radio" name="temper" value="eyas" checked />
                  <span>Eyas</span><small>nest-taken, calm</small>
                </label>
                <label class="tm">
                  <input type="radio" name="temper" value="passage" />
                  <span>Passage</span><small>wild-caught, sharper</small>
                </label>
              </div>
            </fieldset>

            <div class="fit__spec" data-spec>
              <div><dt>Size</dt><dd data-sp-size>{P.spec.size}</dd></div>
              <div><dt>Block</dt><dd data-sp-block>{P.spec.block}</dd></div>
              <div><dt>Eye panel</dt><dd data-sp-eye>{P.spec.eye}</dd></div>
              <div><dt>Leather</dt><dd data-sp-leather>{P.spec.leather}</dd></div>
              <div><dt>Plume</dt><dd data-sp-plume>{P.spec.plume}</dd></div>
              <div><dt>Price</dt><dd data-sp-price>AED {P.spec.price.toLocaleString("en-US")}</dd></div>
            </div>

            <div class="fit__order">
              <label class="fit__field">
                <span class="fit__label">Your name</span>
                <input type="text" name="name" required autocomplete="name" />
                <small class="fit__err">We need a name to write the order against.</small>
              </label>
              <label class="fit__field">
                <span class="fit__label">Email</span>
                <input type="email" name="email" required autocomplete="email" />
                <small class="fit__err">An address we can reach — the bench replies by mail.</small>
              </label>
              <label class="fit__field">
                <span class="fit__label">The bird&rsquo;s name, and anything we should know</span>
                <textarea name="note" rows="2"></textarea>
              </label>

              <button class="btn" type="submit">Commission this hood</button>
              <p class="fit__note" data-fit-note role="status">
                We reply within two days. Nothing is charged here; the
                measurements come to the bench and we write back.
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>


    <hr class="stitch wrap" />

    <!-- IV. The mangalah -->
    <section class="plate" id="mangalah">
      <div class="wrap plate__grid">
        <figure class="plate__fig rv">
          <img src="/images/mangalah.webp" width="900" height="1341"
               alt="A falconer's leather gauntlet with a saker's yellow feet and dark talons gripping it, jesses trailing."
               loading="lazy" decoding="async" />
        </figure>
        <div class="plate__body">
          <p class="record">
            <span>Mangalah</span><i aria-hidden="true">·</i>
            <span>منقلة</span><i aria-hidden="true">·</i>
            <span><b>kid-lined</b></span><i aria-hidden="true">·</i>
            <span>AED 1,600&ndash;2,900</span>
          </p>
          <h2 class="rv">The glove is the only thing you both hold.</h2>
          <p class="lede">
            A falcon's grip closes at a pressure that would open a hand. The
            mangalah takes that and gives nothing back to the bird: four
            layers at the perch line, kid on the inside so the feet do not
            chafe, and a cuff long enough that the jesses run through the
            fingers without a knot.
          </p>
          <dl class="spec">
            <div><dt>Outer</dt><dd>Vegetable-tanned camel</dd></div>
            <div><dt>Lining</dt><dd>Goat kid, undyed</dd></div>
            <div><dt>Perch line</dt><dd>Four layers, hand-stitched</dd></div>
            <div><dt>Cuff</dt><dd>230 mm, blocked</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <hr class="stitch wrap" />

    <!-- V. The mews -->
    <section class="plate plate--flip" id="mews">
      <div class="wrap plate__grid">
        <figure class="plate__fig rv">
          <img src="/images/maker.webp" width="900" height="1341"
               alt="A leatherworker saddle-stitching a falcon hood by lantern light, dusk through the open doorway behind him."
               loading="lazy" decoding="async" />
        </figure>
        <div class="plate__body">
          <p class="record">
            <span>Al Jimi, Al Ain</span><i aria-hidden="true">·</i>
            <span><b>four benches</b></span><i aria-hidden="true">·</i>
            <span>open 06:00 &amp; 17:00</span>
          </p>
          <h2 class="rv">Two shifts, because the birds keep them.</h2>
          <p class="lede">
            The bench works when the birds do, before the heat and again as it goes. Everything is stitched by hand with two needles
            and one thread; a machine seam has a single line that can be pulled
            out from either end, and nothing that goes near a bird is allowed
            to fail that way.
          </p>
          <p class="lede">
            Saif learned the hood from his father, who cut for the Al Ain mews
            when the birds still came in from the passage. He has made eleven
            hundred of them and can still only make four a week.
          </p>
        </div>
      </div>
    </section>

    <hr class="stitch wrap" />

    <!-- VI. What is kept -->
    <section class="kept" id="kept">
      <div class="wrap">
        <p class="record">
          <span>The book</span><i aria-hidden="true">·</i>
          <span><b>1,148 hoods</b></span><i aria-hidden="true">·</i>
          <span>since 1979</span>
        </p>
        <h2 class="rv">Every hood is written down against a bird.</h2>
        <p class="lede narrow">
          A bird's head does not change once it is grown, so the measurements
          outlive the hood. When one wears through, the book gives the pattern
          back, and when a bird is passed on, its hood goes with it.
        </p>

        <table class="book rv">
          <caption class="visually-hidden">Recent commissions from the workshop book</caption>
          <thead>
            <tr><th scope="col">Bird</th><th scope="col">Species</th><th scope="col">Across</th><th scope="col">Size</th><th scope="col">Cut</th><th scope="col"><span class="visually-hidden">Pattern</span></th></tr>
          </thead>
          <tbody>
            <tr><td>Ghazal</td><td>Hurr</td><td>47 mm</td><td data-l="size">5</td><td data-l="cut">2026</td><td><a class="book__cut" href="#burqu" data-recut data-sp="hurr" data-rw="47" data-rh="39" data-tm="eyas">Give the pattern back<span class="visually-hidden"> for Ghazal</span></a></td></tr>
            <tr><td>Sahim</td><td>Gyr-hurr</td><td>50 mm</td><td data-l="size">6</td><td data-l="cut">2026</td><td><a class="book__cut" href="#burqu" data-recut data-sp="hybrid" data-rw="50" data-rh="42" data-tm="passage">Give the pattern back<span class="visually-hidden"> for Sahim</span></a></td></tr>
            <tr><td>Barq</td><td>Shaheen</td><td>41 mm</td><td data-l="size">3</td><td data-l="cut">2025</td><td><a class="book__cut" href="#burqu" data-recut data-sp="shaheen" data-rw="41" data-rh="34" data-tm="passage">Give the pattern back<span class="visually-hidden"> for Barq</span></a></td></tr>
            <tr><td>Rimal</td><td>Hurr</td><td>45 mm</td><td data-l="size">4</td><td data-l="cut">2025</td><td><a class="book__cut" href="#burqu" data-recut data-sp="hurr" data-rw="45" data-rh="37" data-tm="eyas">Give the pattern back<span class="visually-hidden"> for Rimal</span></a></td></tr>
            <tr><td>Nahdah</td><td>Gyr</td><td>52 mm</td><td data-l="size">7</td><td data-l="cut">2024</td><td><a class="book__cut" href="#burqu" data-recut data-sp="gyr" data-rw="52" data-rh="44" data-tm="eyas">Give the pattern back<span class="visually-hidden"> for Nahdah</span></a></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <hr class="stitch wrap" />

    <!-- VII. The rest of the bench -->
    <section class="bench" id="commission">
      <div class="wrap">
        <p class="record">
          <span>The bench</span><i aria-hidden="true">·</i>
          <span>four a week</span><i aria-hidden="true">·</i>
          <span><b>we write back in two days</b></span>
        </p>
        <h2 class="rv">What else leaves the bench.</h2>
        <ul class="wares">
          <li><span class="wares__n">Burqu&rsquo;</span><span class="wares__d">Cut to the bird, above</span><span class="wares__p">AED 1,200 &ndash; 2,400</span></li>
          <li><span class="wares__n">Mangalah</span><span class="wares__d">Camel outer, kid lining</span><span class="wares__p">AED 1,600 &ndash; 2,900</span></li>
          <li><span class="wares__n">Jesses &amp; bewits</span><span class="wares__d">Kangaroo, per pair</span><span class="wares__p">AED 180</span></li>
          <li><span class="wares__n">Bells</span><span class="wares__d">Brass, matched pair, tuned</span><span class="wares__p">AED 320</span></li>
          <li><span class="wares__n">Talwah</span><span class="wares__d">Lure, weighted, corded</span><span class="wares__p">AED 460</span></li>
          <li><span class="wares__n">Block</span><span class="wares__d">Ghaf wood, padded top</span><span class="wares__p">AED 700</span></li>
        </ul>
        <p class="lede narrow">
          Anything above can be ordered from the panel in <a class="link" href="#burqu">the burqu&rsquo;</a>
          ; put the piece in the note. Nothing is charged on this page.
        </p>
      </div>
    </section>

    <footer class="foot">
      <div class="wrap foot__in">
        <p><span lang="ar">حر</span> &nbsp;HURR</p>
        <p class="foot__meta">Al Jimi, Al Ain &middot; Abu Dhabi &middot; 24.2075&deg;N 55.7447&deg;E</p>
        <p class="foot__meta">A Foundry house. Everything here is invented.</p>
      </div>
    </footer>

    <script>
      import { pattern } from "../lib/pattern.mjs";

      const form = document.querySelector<HTMLFormElement>("[data-fit]");
      const svg = document.querySelector<SVGSVGElement>("[data-pattern]");

      if (form && svg) {
        const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;

        const el = {
          left: $<SVGPathElement>("[data-left]"),
          right: $<SVGPathElement>("[data-right]"),
          block: $<SVGPathElement>("[data-block]"),
          socket: $<SVGCircleElement>("[data-socket]"),
          eyeL: $<SVGPathElement>("[data-eyeL]"),
          eyeR: $<SVGPathElement>("[data-eyeR]"),
          brace: $<SVGPathElement>("[data-brace]"),
          dimw: $<SVGLineElement>("[data-dimw]"),
          dimwt: $<HTMLElement>("[data-dimwt]"),
          dimh: $<SVGLineElement>("[data-dimh]"),
          dimht: $<HTMLElement>("[data-dimht]"),
        };

        const outW = $<HTMLOutputElement>("[data-out-w]");
        const outH = $<HTMLOutputElement>("[data-out-h]");
        // Scope to the sliders explicitly: the species radios also carry
        // data-w/h (their typical head), so input[data-w] matched a radio and
        // Number("hurr") made every derived figure NaN.
        const wIn = form.querySelector<HTMLInputElement>('input[type="range"][name="w"]')!;
        const hIn = form.querySelector<HTMLInputElement>('input[type="range"][name="h"]')!;

        function draw() {
          const sp = form.querySelector<HTMLInputElement>('input[name="species"]:checked')!;
          const passage =
            form.querySelector<HTMLInputElement>('input[name="temper"]:checked')!.value === "passage";

          const w = Number(wIn.value);
          const h = Number(hIn.value);
          outW.value = String(w);
          outH.value = String(h);

          // The same module the page was rendered with, so the live drawing
          // can never drift from the one the server produced.
          const P = pattern({ w, h, blockScale: Number(sp.dataset.block), passage });

          svg.setAttribute("viewBox", P.vb);
          el.left.setAttribute("d", P.left);
          el.right.setAttribute("d", P.right);
          el.block.setAttribute("d", P.block);
          el.eyeL.setAttribute("d", P.eyeL);
          el.eyeR.setAttribute("d", P.eyeR);
          el.brace.setAttribute("d", P.brace);
          el.socket.setAttribute("cx", String(P.socket.cx));
          el.socket.setAttribute("cy", String(P.socket.cy));

          el.dimw.setAttribute("x1", String(P.dimW.x1));
          el.dimw.setAttribute("x2", String(P.dimW.x2));
          el.dimw.setAttribute("y1", String(P.dimW.y));
          el.dimw.setAttribute("y2", String(P.dimW.y));
          el.dimwt.style.left = `${P.dimW.pctX}%`;
          el.dimwt.style.top = `${P.dimW.pctY}%`;
          el.dimwt.textContent = P.dimW.label;

          el.dimh.setAttribute("x1", String(P.dimH.x));
          el.dimh.setAttribute("x2", String(P.dimH.x));
          el.dimh.setAttribute("y1", String(P.dimH.y1));
          el.dimh.setAttribute("y2", String(P.dimH.y2));
          el.dimht.style.left = `${P.dimH.pctX}%`;
          el.dimht.style.top = `${P.dimH.pctY}%`;
          el.dimht.textContent = P.dimH.label;

          $("[data-sp-size]").textContent = String(P.spec.size);
          $("[data-sp-block]").textContent = P.spec.block;
          $("[data-sp-eye]").textContent = P.spec.eye;
          $("[data-sp-leather]").textContent = P.spec.leather;
          $("[data-sp-plume]").textContent = P.spec.plume;
          $("[data-sp-price]").textContent = `AED ${P.spec.price.toLocaleString("en-US")}`;

          $("[data-rd-size]").textContent = `size ${P.spec.size}`;
          $("[data-rd-leather]").textContent = `${P.spec.leather} kid-lined goat`;
          $("[data-cap-species]").textContent =
            sp.parentElement!.querySelector(".sp__la")!.textContent!;
          $("[data-cap-temper]").textContent = passage ? "wild-caught" : "nest-taken";
        }

        form.querySelectorAll<HTMLInputElement>('input[name="species"]').forEach((r) =>
          r.addEventListener("change", () => {
            wIn.value = r.dataset.w!;
            hIn.value = r.dataset.h!;
            draw();
          })
        );

        form.addEventListener("input", draw);
        draw();

        // "The book gives the pattern back" — the copy is literal, so the row
        // loads that bird's measurements into the panel rather than being a
        // hover colour that does nothing.
        document.querySelectorAll<HTMLAnchorElement>("[data-recut]").forEach((a) => {
          a.addEventListener("click", () => {
            const d = a.dataset;
            form.querySelector<HTMLInputElement>(`input[name="species"][value="${d.sp}"]`)!.checked = true;
            form.querySelector<HTMLInputElement>(`input[name="temper"][value="${d.tm}"]`)!.checked = true;
            wIn.value = d.rw!;
            hIn.value = d.rh!;
            draw();
          });
        });

        form.addEventListener("submit", (e) => {
          e.preventDefault();
          const note = $<HTMLElement>("[data-fit-note]");

          // An undesigned failure path is the one interaction that loses a
          // commission, so the form says what is missing in its own voice
          // rather than leaving it to a browser bubble.
          if (!form.checkValidity()) {
            form.classList.add("is-checked");
            note.classList.remove("is-sent");
            note.classList.add("is-bad");
            const missing = form.querySelectorAll("input:invalid").length;
            note.textContent =
              missing === 1
                ? "One thing is still missing before this can go to the bench."
                : `${missing} things are still missing before this can go to the bench.`;
            form.querySelector<HTMLInputElement>("input:invalid")?.focus();
            return;
          }

          note.classList.remove("is-bad");
          note.textContent =
            "Sent. The measurements are at the bench. We write back within two days.";
          note.classList.add("is-sent");
        });
      }

      // Entrances only when motion was opted into.
      if (document.documentElement.classList.contains("fx")) {
        const io = new IntersectionObserver(
          (es) => es.forEach((x) => x.isIntersecting && (x.target.classList.add("landed"), io.unobserve(x.target))),
          { rootMargin: "0px 0px -8% 0px" }
        );
        document.querySelectorAll(".settle").forEach((n) => io.observe(n));
      }
    </script>
  </body>
</html>
