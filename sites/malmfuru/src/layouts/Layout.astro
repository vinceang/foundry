---
import '../styles/global.css';
import { meta, nav, footer } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ?? meta.title;
const pageDesc = description ?? meta.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0b0e13" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Forum&family=Schibsted+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const r = document.documentElement;
      if (location.search.includes("nofx")) r.classList.add("nofx");
      else if (!matchMedia("(prefers-reduced-motion: reduce)").matches)
        r.classList.add("fx");

      // `?nofx` keeps everything visible; `?scroll=N` jumps to an offset —
      // both exist for the screenshot critique loop only.
      if (!location.search.includes('nofx')) document.documentElement.classList.add('js');
      else addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('img[loading="lazy"]').forEach((i) => (i.loading = 'eager'));
        const m = location.search.match(/scroll=(\d+)/);
        if (m) addEventListener('load', () => setTimeout(() => scrollTo(0, +m[1]), 300));
      });
    </script>
  </head>
  <body>
    <div class="cursor" aria-hidden="true"></div>
    <div class="hud-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <header class="site-header">
      <a class="brand" href="/" aria-label={nav.brandAria}>
        <span class="brand-seal" aria-hidden="true">
          <!-- the nov: two log-ends lapped, with overhang -->
          <svg viewBox="0 0 32 32" width="32" height="32" fill="none">
            <rect x="4" y="12.5" width="24" height="7" stroke="var(--kopar-faint)" stroke-width="1.2" />
            <rect x="12.5" y="4" width="7" height="24" stroke="var(--kopar)" stroke-width="1.2" fill="var(--natt)" />
            <line x1="12.5" y1="12.5" x2="19.5" y2="19.5" stroke="var(--kopar-faint)" stroke-width="1" />
          </svg>
        </span>
        <span class="brand-word">Malmfuru</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#timber">{nav.timber}</a>
        <a href="/#ringer">{nav.rings}</a>
        <a href="/#tun">{nav.tun}</a>
        <a href="/#setning">{nav.setning}</a>
        <a class="nav-cta" href="/tinging/">{nav.cta}</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <p class="footer-mark">Malmfuru</p>
          <p style="margin-top: 16px; max-width: 38ch; font-size: 13.5px; color: var(--ull-dim);">
            {footer.blurb}
          </p>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">{footer.houseTitle}</h4>
          <ul>
            {footer.houseLinks.map((l) => (
              <li><a href={`/${l.href}`}>{l.t}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">{footer.visitTitle}</h4>
          <ul>
            {footer.visitLines.map((v) => <li>{v}</li>)}
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">{footer.corrTitle}</h4>
          <ul>
            <li><a href={`mailto:${footer.corrMail}`}>{footer.corrMail}</a></li>
            <li>{footer.corrLine}</li>
          </ul>
        </div>
      </div>
      <div class="footer-legal">
        <span>{footer.legal}</span>
        <span>{footer.legalNote}</span>
      </div>
    </footer>

    <script>
      // ---- reveal on scroll ----
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.16, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('.rv, .rv-line').forEach((el) => io.observe(el));

      // ---- header veil / withdraw ----
      const header = document.querySelector('.site-header') as HTMLElement;
      let lastY = scrollY;
      const headerTick = () => {
        const y = scrollY;
        header.classList.toggle('is-veiled', y > 40);
        if (y > 240 && y > lastY + 4) header.classList.add('is-withdrawn');
        else if (y < lastY - 4 || y <= 240) header.classList.remove('is-withdrawn');
        lastY = y;
      };
      addEventListener('scroll', headerTick, { passive: true });
      headerTick();

      // ---- the daylight line at Nore (see DESIGN.md §5) ----
      // Day length from date at lat 60.1°N — the workshop's real calendar.
      const dl = document.querySelector<HTMLElement>('[data-daylight]');
      if (dl) {
        const LAT = (60.1 * Math.PI) / 180;
        const small = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen'];
        const tens = ['', '', 'twenty', 'thirty', 'forty', 'fifty'];
        const words = (n: number) =>
          n < 20 ? small[n] : tens[Math.floor(n / 10)] + (n % 10 ? '-' + small[n % 10] : '');
        const tick = () => {
          const now = new Date();
          const start = Date.UTC(now.getUTCFullYear(), 0, 0);
          const doy = Math.floor((now.getTime() - start) / 86400000);
          const decl = ((-23.44 * Math.cos(((2 * Math.PI) / 365) * (doy + 10))) * Math.PI) / 180;
          const cosH = Math.min(1, Math.max(-1, -Math.tan(LAT) * Math.tan(decl)));
          const hours = (2 * (Math.acos(cosH) * 180 / Math.PI)) / 15;
          const h = Math.floor(hours);
          const m = Math.round((hours - h) * 60);
          const band = hours < 7 ? 'the felling light' : hours <= 16 ? 'the hewing light' : 'the raising light';
          const t = new Intl.DateTimeFormat('en-GB', {
            timeZone: 'Europe/Oslo', hour: '2-digit', minute: '2-digit', hour12: false,
          }).format(now);
          dl.textContent = `Nore, ${t} — ${words(h)} hours, ${words(m)} minutes of daylight today. This is ${band}.`;
        };
        tick();
        setInterval(tick, 60_000);
      }

      // ---- custom cursor ----
      const fine = matchMedia('(pointer: fine)').matches;
      const noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !noMotion) {
        document.documentElement.classList.add('cursor-on');
        const cur = document.querySelector('.cursor') as HTMLElement;
        let x = 0, y = 0, cx = 0, cy = 0;
        addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; });
        const loop = () => {
          cx += (x - cx) * 0.22;
          cy += (y - cy) * 0.22;
          cur.style.translate = `${cx}px ${cy}px`;
          requestAnimationFrame(loop);
        };
        loop();
        document.querySelectorAll('a, button, input, [data-cursor]').forEach((el) => {
          el.addEventListener('mouseenter', () => cur.classList.add('is-link'));
          el.addEventListener('mouseleave', () => cur.classList.remove('is-link'));
        });
      }

      // ---- gentle parallax on marked media ----
      if (!noMotion) {
        const px = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (px.length) {
          let ticking = false;
          const update = () => {
            const vh = innerHeight;
            for (const el of px) {
              const r = el.getBoundingClientRect();
              if (r.bottom < -80 || r.top > vh + 80) continue;
              const p = (r.top + r.height / 2 - vh / 2) / vh;
              const depth = parseFloat(el.dataset.parallax || '24');
              el.style.transform = `translateY(${(-p * depth).toFixed(2)}px) scale(1.06)`;
            }
            ticking = false;
          };
          addEventListener('scroll', () => {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          update();
        }
      }
    </script>
  </body>
</html>
