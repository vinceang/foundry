---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Velum — private charter out of Geneva since 1987. Three tails, no livery, no public number. Introductions through current clients or the desks at Geneva and Farnborough."
    />
    <title>Velum — Genève Aéroport, est. 1987</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;1,200;1,300&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="preload" as="image" href="/images/hero-apron.jpg" />
    <script is:inline>
      const q = new URLSearchParams(location.search);
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.documentElement.classList.add("js");
      if (!q.has("nofx") && !reduced) document.documentElement.classList.add("fx");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#operation">Skip to content</a>

    <header class="site-header" id="top">
      <a class="wordmark" href="#top">Velum <small>Genève · est. 1987</small></a>
      <nav class="site-nav" aria-label="Sections">
        <a href="#operation">Operation</a>
        <a href="#tails">Tails</a>
        <a href="#legs">Legs</a>
        <a class="nav-intro" href="#introduction">Introduction</a>
      </nav>
    </header>

    <!-- signature: the flight-plan rail — the page is a flight, this instrument flies it -->
    <div class="fp-rail" aria-hidden="true">
      <p class="fp-readout">
        <span class="fp-phase" id="fp-phase">OFF BLOCKS</span><span class="fp-fl" id="fp-fl">FL000</span>
      </p>
      <svg class="fp-svg" width="168" height="44" viewBox="0 0 168 44">
        <line class="fp-ground" x1="0" y1="41.5" x2="168" y2="41.5"></line>
        <path
          class="fp-path"
          id="fp-path"
          d="M4 40 L20 40 C 40 40 44 8 66 8 L104 8 C 126 8 130 40 150 40 L164 40"
        ></path>
        <path class="fp-path-flown" id="fp-flown" d="M4 40 L20 40 C 40 40 44 8 66 8 L104 8 C 126 8 130 40 150 40 L164 40"></path>
        <circle class="fp-dot" id="fp-dot" cx="4" cy="40" r="2.6"></circle>
      </svg>
    </div>

    <main>
      <!-- ============ OFF BLOCKS · hero ============ -->
      <section class="hero" id="hero" data-phase="OFF BLOCKS" aria-label="Velum">
        <div class="hero-media">
          <img
            src="/images/hero-apron.jpg"
            alt="An unmarked white long-range jet alone on a wet apron at civil twilight, a thin apricot band of last light on the horizon behind it."
            fetchpriority="high"
          />
        </div>
        <div class="hero-copy">
          <span class="mono">Vesper · 46°14′ N 6°06′ E · Genève Aéroport, north apron</span>
          <h1 class="hero-title">Velum</h1>
          <p class="hero-sub">The least visible way to the fields without a terminal.</p>
          <div class="hero-facts">
            <span class="mono">Est. 1987</span>
            <span class="mono">Three tails</span>
            <span class="mono">Callsign VELUM</span>
          </div>
        </div>
        <p class="hero-caption">HB-JVL · off blocks 21:14<br />civil twilight</p>
        <div class="horizon-rule"></div>
      </section>

      <!-- ============ CLIMB · the operation ============ -->
      <section class="section" id="operation" data-phase="CLIMB" aria-labelledby="operation-h">
        <div class="chapter-head reveal">
          <span class="whisper">Climb · the operation</span>
          <h2 class="statement" id="operation-h">
            Eleven families made the client book. Introductions still do.
          </h2>
        </div>
        <div class="split">
          <div class="reveal">
            <p class="body-copy">
              Velum began in 1987, when two Swissair captains left the flag carrier to fly
              privately for the families they already knew by name. The operation has never
              advertised. The aircraft are white and carry no name; the registry lists a
              holding company in Zug, as is normal practice; the tails do not appear on
              public trackers.
            </p>
            <p class="body-copy">
              Each client is assigned one dispatcher — a person, not a desk — who keeps the
              account for years. You message the dispatcher. The dispatcher files the plan,
              positions the aircraft, clears the car onto the apron, and meets you at the
              wing. <span class="dim">Crews are salaried, never freelanced; the median tenure
              is eleven years.</span>
            </p>
            <p class="admission">
              We are not the least expensive way to fly. We are the least visible.
            </p>
          </div>
          <div class="reveal">
            <p class="withheld-title">Withheld, as a matter of practice</p>
            <ul class="withheld">
              <li><span>Livery</span><span>white fuselage, grey registration</span></li>
              <li><span>Tail tracking</span><span>blocked on public receivers</span></li>
              <li><span>Manifests</span><span>never sold, never shared</span></li>
              <li><span>Client names</span><span>not even the eleven</span></li>
              <li><span>Photography of guests</span><span>none exists</span></li>
              <li><span>A public number</span><span>see the last line of this page</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- cruise interlude -->
      <figure class="interlude" data-phase="CRUISE">
        <img
          src="/images/cabin-cruise.jpg"
          alt="A jet cabin in near darkness at cruise: one oval window holding a deep blue sky and a thin apricot horizon, a single low reading lamp."
          loading="lazy"
        />
        <figcaption>FL450 · 21:52 CET · somewhere over the Loire</figcaption>
      </figure>

      <!-- ============ CRUISE · tails ============ -->
      <section class="section" id="tails" data-phase="CRUISE" aria-labelledby="tails-h">
        <div class="chapter-head reveal">
          <span class="whisper">Cruise FL450 · the tails</span>
          <h2 class="statement" id="tails-h">
            Three aircraft, chosen for range, quiet, and where they can put&nbsp;down.
          </h2>
        </div>

        <article class="tail reveal">
          <div class="tail-media">
            <img
              src="/images/tail-global.jpg"
              alt="The nose and darkened flight deck of the Global 6500 on a wet apron at civil twilight, a thin apricot line along the top of the fuselage and the last of the band low on the horizon behind."
              loading="lazy"
            />
          </div>
          <div class="tail-spec">
            <span class="tail-reg">HB-JVL</span>
            <h3 class="tail-name">Bombardier Global 6500</h3>
            <dl class="spec-rows">
              <div><dt>Range</dt><dd>6,600 nm</dd></div>
              <div><dt>Cruise</dt><dd>Mach 0.90</dd></div>
              <div><dt>Cabin</dt><dd>three zones · berths for eight</dd></div>
            </dl>
            <p class="tail-use">
              <em>The Atlantic and further.</em> Geneva to Los Angeles without stopping;
              the cabin holds a 4,500-foot altitude while you sleep.
            </p>
          </div>
        </article>

        <article class="tail flip reveal">
          <div class="tail-media">
            <img
              src="/images/tail-falcon.jpg"
              alt="The unmarked white fuselage and engine nacelle of a Falcon 8X, the last apricot light along its upper edges."
              loading="lazy"
            />
          </div>
          <div class="tail-spec">
            <span class="tail-reg">HB-JLA</span>
            <h3 class="tail-name">Dassault Falcon 8X</h3>
            <dl class="spec-rows">
              <div><dt>Range</dt><dd>6,450 nm</dd></div>
              <div><dt>Runway</dt><dd>from 1,830 m</dd></div>
              <div><dt>Cabin</dt><dd>the quietest flying</dd></div>
            </dl>
            <p class="tail-use">
              <em>The continent, daily.</em> Three lounges, and quiet enough that two
              people at opposite ends of the cabin speak at a normal register.
            </p>
          </div>
        </article>

        <article class="tail reveal">
          <div class="tail-media tall">
            <img
              src="/images/pc24-gravel.jpg"
              alt="A small unmarked white jet on a gravel strip in a high alpine valley at dusk, snow-dusted mountains going dark behind."
              loading="lazy"
            />
          </div>
          <div class="tail-spec">
            <span class="tail-reg">HB-VSK</span>
            <h3 class="tail-name">Pilatus PC-24</h3>
            <dl class="spec-rows">
              <div><dt>Range</dt><dd>2,000 nm</dd></div>
              <div><dt>Field</dt><dd>893 m · gravel and grass</dd></div>
              <div><dt>Built</dt><dd>Stans, canton Nidwalden</dd></div>
            </dl>
            <p class="tail-use">
              <em>The places the others cannot go.</em> Samedan at first light, La Môle in
              August, strips with no name on the departure board.
            </p>
          </div>
        </article>
      </section>

      <!-- ============ DESCENT · legs ============ -->
      <section class="section" id="legs" data-phase="DESCENT" aria-labelledby="legs-h">
        <div class="chapter-head reveal">
          <span class="whisper">Descent · the legs</span>
          <h2 class="statement" id="legs-h">Last week, flown quietly.</h2>
        </div>
        <div class="reveal">
          <table class="legs-table">
            <caption>Block log · week 29</caption>
            <tbody>
              <tr>
                <td class="leg-route">GVA → FAB</td>
                <td class="leg-block">0:54 block</td>
                <td class="leg-note">two passengers · car to the wing at both ends</td>
              </tr>
              <tr>
                <td class="leg-route">FAB → NCE</td>
                <td class="leg-block">1:41 block</td>
                <td class="leg-note">a family of four, one dog, no terminal</td>
              </tr>
              <tr>
                <td class="leg-route">GVA → SMV</td>
                <td class="leg-block">0:31 block</td>
                <td class="leg-note">Samedan, 05:58 · skis through the cargo door</td>
              </tr>
              <tr class="withheld-leg">
                <td class="leg-route">••• → •••</td>
                <td class="leg-block">–:–– block</td>
                <td class="leg-note">withheld at the client’s request</td>
              </tr>
              <tr>
                <td class="leg-route">SMV → GVA</td>
                <td class="leg-block">0:29 block</td>
                <td class="leg-note">positioning, empty</td>
              </tr>
              <tr>
                <td class="leg-route">GVA → TEB</td>
                <td class="leg-block">8:22 block</td>
                <td class="leg-note">the Global, westbound into a long evening</td>
              </tr>
            </tbody>
          </table>
          <p class="legs-note">
            Empty legs are offered to clients only, by message, the evening before.
            They are never published.
          </p>
        </div>
      </section>

      <!-- ============ ON BLOCKS · introduction ============ -->
      <section class="section intro-section" id="introduction" data-phase="ON BLOCKS" aria-labelledby="intro-h">
        <div class="chapter-head reveal">
          <span class="whisper">On blocks · the introduction</span>
          <h2 class="statement" id="intro-h">
            There is no telephone number on this page. This is not an oversight.
          </h2>
        </div>
        <div class="reveal">
          <p class="body-copy">
            Introductions come through a current client, or through the desks at Geneva
            and Farnborough that have known the operation since 1987. Write, and a
            dispatcher answers within the hour — from a name, not a department.
          </p>
          <div class="intro-actions">
            <a class="intro-mail" href="mailto:dispatch@velum.aero">dispatch@velum.aero</a>
            <span class="intro-aftn">AFTN LSGGVLMX</span>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>Velum SA · Genève Aéroport · north apron</span>
      <span>46°14′ N 6°06′ E · callsign VELUM</span>
      <span>Est. 1987 · three tails · no livery</span>
    </footer>

    <script is:inline>
      (() => {
        // ---- header veil ----
        const header = document.querySelector(".site-header");
        addEventListener("scroll", () => {
          header.classList.toggle("veiled", scrollY > 40);
        }, { passive: true });

        // ---- flight-plan rail ----
        const phaseEl = document.getElementById("fp-phase");
        const flEl = document.getElementById("fp-fl");
        const dot = document.getElementById("fp-dot");
        const path = document.getElementById("fp-path");
        const flown = document.getElementById("fp-flown");
        if (!phaseEl || !path) return;

        const pathLen = path.getTotalLength();
        flown.style.strokeDasharray = pathLen;
        flown.style.strokeDashoffset = pathLen;

        // legs of the flight = sections of the page
        const stops = [
          { el: document.getElementById("hero"), phase: "OFF BLOCKS" },
          { el: document.getElementById("operation"), phase: "CLIMB" },
          { el: document.getElementById("tails"), phase: "CRZ" },
          { el: document.getElementById("legs"), phase: "DESCENT" },
          { el: document.getElementById("introduction"), phase: "ON BLOCKS" },
        ];

        let bounds = [];
        const measure = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bounds = stops.map((s) => Math.min(1, s.el.offsetTop / Math.max(1, max)));
          bounds.push(1);
        };
        measure();
        addEventListener("resize", measure);

        // altitude profile over page progress p (0..1):
        // 0 on the ground, climb through CLIMB, FL450 across CRUISE, down through DESCENT
        const altitude = (p) => {
          const climbStart = bounds[1], cruiseStart = bounds[2];
          const desStart = bounds[3], desEnd = bounds[4];
          if (p <= climbStart) return 0;
          if (p <= cruiseStart) return (450 * (p - climbStart)) / (cruiseStart - climbStart);
          if (p <= desStart) return 450;
          if (p <= desEnd) return 450 * (1 - (p - desStart) / (desEnd - desStart));
          return 0;
        };
        const phaseAt = (p) => {
          for (let i = stops.length - 1; i >= 0; i--) {
            if (p >= bounds[i] - 0.001) return stops[i].phase;
          }
          return stops[0].phase;
        };

        let ticking = false;
        const update = () => {
          ticking = false;
          const max = document.documentElement.scrollHeight - innerHeight;
          const p = Math.min(1, Math.max(0, scrollY / Math.max(1, max)));
          const fl = Math.round(altitude(p) / 5) * 5;
          phaseEl.textContent = phaseAt(p);
          flEl.textContent = "FL" + String(fl).padStart(3, "0");
          const pt = path.getPointAtLength(p * pathLen);
          dot.setAttribute("cx", pt.x);
          dot.setAttribute("cy", pt.y);
          flown.style.strokeDashoffset = pathLen * (1 - p);
        };
        addEventListener("scroll", () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();

        // ---- reveals (fx only) ----
        if (document.documentElement.classList.contains("fx")) {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) {
              if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
            }
          }, { threshold: 0.12 });
          document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
        } else {
          document.querySelectorAll(".reveal").forEach((el) => el.classList.add("in"));
        }
      })();
    </script>
  </body>
</html>
