---
import Layout from '../layouts/Layout.astro';
import { works, sealedWorks } from '../data/works';
---

<Layout
  title="Shokunin — Bespoke Samurai Ateliers"
  description="A private house of master ateliers. Twelve works of samurai armor and blade a year, entered into the Register and released by petition."
>
  <!-- chapter rail — desktop wayfinding -->
  <nav class="chapters" aria-label="Chapters">
    <a href="#top" data-ch="top"><i></i><span>Entrance</span></a>
    <a href="#doctrine" data-ch="doctrine"><i></i><span>Doctrine</span></a>
    <a href="#register" data-ch="register"><i></i><span>The Register</span></a>
    <a href="#ateliers" data-ch="ateliers"><i></i><span>Ateliers</span></a>
    <a href="#commission" data-ch="commission"><i></i><span>Commission</span></a>
  </nav>

  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <div class="hero-media" aria-hidden="true">
      <img src="/works/hero.jpg" alt="" fetchpriority="high" />
      <video
        class="hero-video"
        src="/works/hero-loop.mp4"
        poster="/works/hero.jpg"
        muted
        playsinline
        preload="none"
      ></video>
      <div class="hero-shade"></div>
      <canvas class="hero-dust" aria-hidden="true"></canvas>
    </div>

    <p class="hero-rail kanji vertical-rl" aria-hidden="true">一芸一生</p>

    <div class="hero-inner">
      <p class="label rv" style="--d: 1">Bespoke samurai ateliers · est. Kyōto</p>
      <h1 class="display hero-title">
        <span class="rv-line" style="--d: 2"><span>Shokunin</span></span>
      </h1>
      <p class="hero-sub rv" style="--d: 4">
        Twelve works a year. Each entered into the Register,
        sealed by its maker, and released only by petition.
      </p>
      <div class="hero-actions rv" style="--d: 5">
        <a class="btn-gold" href="#register">Enter the Register</a>
        <a class="btn-ghost" href="/petition/?matter=audience">Request an audience</a>
      </div>
    </div>

    <a class="scroll-cue" href="#doctrine" aria-label="Scroll to the doctrine">
      <span class="label label--dim">Descend</span>
      <i aria-hidden="true"></i>
    </a>
  </section>

  <!-- ============ DOCTRINE ============ -->
  <section class="doctrine hishimon" id="doctrine">
    <p class="doctrine-kanji kanji" aria-hidden="true">職人</p>
    <div class="doctrine-inner">
      <p class="label rv">The doctrine</p>
      <h2 class="display doctrine-line">
        <span class="rv-line" style="--d: 1"><span>We do not sell armor.</span></span>
        <span class="rv-line" style="--d: 2"><span>We release it.</span></span>
      </h2>
      <p class="doctrine-copy rv" style="--d: 3">
        Shokunin is a house of three ateliers — armorers, swordsmiths and lacquer
        masters whose lineages together hold more than a thousand years of craft.
        Each year the house completes twelve works. No more are made because no
        more can be made properly. Each is documented, sealed and entered into
        the Register; collectors petition for the right to hold one.
      </p>
      <div class="doctrine-facts rv" style="--d: 4">
        <div><strong class="display">12</strong><span class="label label--dim">Works a year</span></div>
        <div><strong class="display">3</strong><span class="label label--dim">Master ateliers</span></div>
        <div><strong class="display">53</strong><span class="label label--dim">Generations combined</span></div>
      </div>
    </div>
  </section>

  <!-- ============ THE REGISTER ============ -->
  <section class="register" id="register">
    <div class="register-head">
      <div class="register-title">
        <div>
          <p class="label rv">The Register · MMXXVI</p>
          <h2 class="display rv" style="--d: 1">Works of the year</h2>
        </div>
        <p class="register-year kanji vertical-rl rv" style="--d: 2" aria-hidden="true">二〇二六年 銘鑑</p>
      </div>
      <p class="register-note rv" style="--d: 2">
        Three works currently stand open. The remainder of the year is sealed.
      </p>
    </div>

    {works.map((w, i) => (
      <a class={`work ${w.portrait ? 'work--portrait' : 'work--wide'}`} href={`/works/${w.slug}/`}>
        <figure class="work-media">
          <img src={w.image} alt={w.imageAlt} loading="lazy" data-parallax="30" />
        </figure>
        <div class="work-meta">
          <p class="work-no display rv">{w.no}<span> / XII</span></p>
          <h3 class="display work-name rv" style="--d: 1">
            {w.name} <span class="kanji work-kanji">{w.kanji}</span>
          </h3>
          <p class="work-cat label label--dim rv" style="--d: 2">{w.category}</p>
          <p class="work-lede rv" style="--d: 3">{w.lede}</p>
          <div class="work-row rv" style="--d: 4">
            <span class="work-price">{w.price}</span>
            <span class={`work-status ${w.status === 'Under petition' ? 'is-pending' : ''}`}>{w.status}</span>
          </div>
          <span class="work-open label rv" style="--d: 5">Open the dossier →</span>
        </div>
      </a>
    ))}

    <!-- sealed ledger -->
    <div class="sealed rv">
      <p class="label label--dim" style="margin-bottom: 24px;">Sealed until their season</p>
      {sealedWorks.map((s) => (
        <div class="sealed-row">
          <span class="display sealed-no">{s.no}</span>
          <span class="sealed-hint">{s.hint}</span>
          <span class="sealed-when label label--dim">{s.unseal}</span>
          <span class="sealed-lock" aria-hidden="true">◇</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ ATELIERS ============ -->
  <section class="ateliers" id="ateliers">
    <div class="ateliers-grid">
      <figure class="ateliers-media rv">
        <div class="ateliers-media-frame">
          <img src="/works/atelier-succession.jpg" alt="An urushi master guiding a young apprentice as they lacquer a kabuto at a night workshop" loading="lazy" data-parallax="20" />
        </div>
        <figcaption class="label label--dim">Shirakawa Iori, eleventh keeper · instruction at the lacquer bench</figcaption>
      </figure>
      <div class="ateliers-copy">
        <p class="label rv">The ateliers</p>
        <h2 class="display rv" style="--d: 1">Three houses.<br />One oath.</h2>
        <p class="rv" style="--d: 2">
          House Mizuno raises iron in Kaga as it has for sixteen generations.
          The Kanemoto forge in Seki has folded steel since the age of the
          warring states. Shirakawa of Wajima lays lacquer in a room kept at
          the humidity of a sea cave. Each master signs an oath into every
          work’s register entry: that nothing left the bench before it was
          finished, and nothing finished was hurried.
        </p>
        <ul class="atelier-list rv" style="--d: 3">
          <li><strong>House Mizuno</strong> · armorers, Kaga <span>16th generation</span></li>
          <li><strong>Kanemoto Forge</strong> · swordsmiths, Seki <span>26th generation</span></li>
          <li><strong>Shirakawa Studio</strong> · urushi masters, Wajima <span>11th generation</span></li>
        </ul>
      </div>
    </div>
    <div class="ateliers-detail">
      <div class="ateliers-detail-copy">
        <p class="label rv">The binding</p>
        <h3 class="display rv" style="--d: 1">The cord is<br />drawn last.</h3>
        <p class="rv" style="--d: 2">
          Each iron scale receives eight grounds of black urushi. Every ground
          cures for nineteen days in cedar humidity before the next is laid.
          Only then does kachi-iro silk bind the rows — tensioned by hand so
          the cuirass can move without losing its line.
        </p>
        <dl class="ateliers-detail-facts rv" style="--d: 3">
          <div><dt class="label label--dim">Lacquer</dt><dd>8 hand-laid grounds</dd></div>
          <div><dt class="label label--dim">Cure</dt><dd>19 days per ground</dd></div>
          <div><dt class="label label--dim">Lacing</dt><dd>340 hours per cuirass</dd></div>
        </dl>
      </div>
      <figure class="ateliers-detail-media rv" style="--d: 2">
        <div class="ateliers-detail-frame">
          <img src="/works/lacing.jpg" alt="Macro view of lacquered armor scales bound with indigo silk cords" loading="lazy" data-parallax="20" />
        </div>
        <figcaption class="label label--dim">Kachi-iro silk over eight grounds of kuro-urushi</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ COMMISSION ============ -->
  <section class="commission hishimon" id="commission">
    <div class="commission-inner">
      <p class="label rv">The twelfth work</p>
      <h2 class="display rv" style="--d: 1">One commission a year<br />is accepted.</h2>
      <p class="commission-copy rv" style="--d: 2">
        Work XII of every Register is reserved for a single patron: a full
        ō-yoroi armor, built to the patron’s measure and family crest over
        fourteen months. The process is unchanged since the house was founded.
      </p>

      <ol class="rite">
        <li class="rv" style="--d: 3">
          <span class="rite-no display">01</span>
          <div><h3 class="display">Petition</h3><p>A letter to the Register stating who you are and what you ask the house to make.</p></div>
          <span class="rite-when label label--dim">One letter</span>
        </li>
        <li class="rv" style="--d: 4">
          <span class="rite-no display">02</span>
          <div><h3 class="display">Audience</h3><p>A meeting with the three masters, in Kyōto or where you stand. Measures are taken; the crest is drawn.</p></div>
          <span class="rite-when label label--dim">One day</span>
        </li>
        <li class="rv" style="--d: 5">
          <span class="rite-no display">03</span>
          <div><h3 class="display">The making</h3><p>You receive the forge record as it is written — plate by plate, ground by ground.</p></div>
          <span class="rite-when label label--dim">Fourteen months</span>
        </li>
        <li class="rv" style="--d: 6">
          <span class="rite-no display">04</span>
          <div><h3 class="display">Investiture</h3><p>The finished work is presented, sealed into the Register, and released into your keeping.</p></div>
          <span class="rite-when label label--dim">One evening</span>
        </li>
      </ol>

      <div class="commission-cta rv" style="--d: 7">
        <a class="btn-gold" href="/petition/?matter=commission">Write to the Register</a>
        <p class="label label--dim">The 2027 commission opens to petition in September</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  // ---- chapter rail scroll-spy ----
  const links = document.querySelectorAll<HTMLAnchorElement>('.chapters a');
  if (links.length) {
    const targets = ['top', 'doctrine', 'register', 'ateliers', 'commission']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    const setActive = () => {
      let current = targets[0];
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= innerHeight * 0.45) current = t;
      }
      links.forEach((a) => a.classList.toggle('on', a.dataset.ch === current.id));
    };
    addEventListener('scroll', setActive, { passive: true });
    setActive();
  }

  // ---- hero video loop (desktop, motion-tolerant, data-saver off) ----
  const vid = document.querySelector<HTMLVideoElement>('.hero-video');
  const noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wide = matchMedia('(min-width: 900px)').matches;
  // @ts-expect-error - saveData is not yet in all TS lib DOMs
  const saveData = navigator.connection?.saveData === true;
  if (vid && !noMotion && wide && !saveData && !location.search.includes('nofx')) {
    vid.preload = 'auto';
    vid.addEventListener('canplaythrough', () => {
      vid.play().then(() => vid.classList.add('is-playing')).catch(() => {});
    }, { once: true });
    vid.addEventListener('timeupdate', () => {
      if (vid.duration && vid.duration - vid.currentTime < 1) {
        vid.classList.add('is-dipping');
      }
    });
    vid.addEventListener('ended', () => {
      vid.currentTime = 0;
      // hold on the still a beat before the light breathes again
      setTimeout(() => {
        vid.classList.remove('is-dipping');
        vid.play().catch(() => {});
      }, 1600);
    });
    vid.load();
  }

  // ---- hero dust motes ----
  const canvas = document.querySelector<HTMLCanvasElement>('.hero-dust');
  const still = noMotion;
  if (canvas && !still) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, visible = true;
    const size = () => {
      w = canvas.width = canvas.offsetWidth;
      h = canvas.height = canvas.offsetHeight;
    };
    size();
    addEventListener('resize', size);
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    type Mote = { x: number; y: number; r: number; vx: number; vy: number; tw: number; ph: number };
    const motes: Mote[] = Array.from({ length: 42 }, () => ({
      x: Math.random(), y: Math.random(), r: .5 + Math.random() * 1.4,
      vx: -.00003 - Math.random() * .00007,
      vy: -.00006 - Math.random() * .00009,
      tw: .6 + Math.random() * 2.2, ph: Math.random() * Math.PI * 2,
    }));
    const tick = (t: number) => {
      requestAnimationFrame(tick);
      if (!visible) return;
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.x = (m.x + m.vx + 1) % 1;
        m.y = (m.y + m.vy + 1) % 1;
        const a = .12 + .3 * Math.abs(Math.sin(m.ph + t / (1400 * m.tw)));
        // brighter inside the light shaft (upper middle)
        const shaft = Math.max(0, 1 - Math.abs(m.x - .52) * 3.4) * (1 - m.y * .55);
        ctx.beginPath();
        ctx.arc(m.x * w, m.y * h, m.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(230, 205, 147, ${(a * (0.25 + shaft)).toFixed(3)})`;
        ctx.fill();
      }
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero-media { position: absolute; inset: 0; }
  .hero-media img {
    width: 100%; height: 100%; object-fit: cover;
    animation: heroDrift 26s var(--ease) both;
    transform-origin: 50% 30%;
  }
  @keyframes heroDrift {
    from { transform: scale(1.14); }
    to   { transform: scale(1.02); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-media img { animation: none; } }

  /* video layer sits over the still; fades in only once it can actually play.
     Near the end of each pass it dips back to the still (its own first frame)
     so the restart reads as breathing light, not a loop seam. */
  .hero-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0;
    transition: opacity 2.2s var(--ease);
  }
  .hero-video.is-playing { opacity: 1; }
  .hero-video.is-dipping { opacity: 0; transition-duration: .9s; }
  .hero-shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, var(--urushi) 4%, rgba(18,13,10,.44) 34%, transparent 62%),
      linear-gradient(to right, rgba(10,7,5,.62), transparent 55%);
  }
  @media (max-width: 760px) {
    .hero-shade {
      background:
        linear-gradient(to top, var(--urushi) 12%, rgba(18,13,10,.72) 44%, rgba(18,13,10,.18) 70%),
        linear-gradient(to right, rgba(10,7,5,.5), transparent 70%);
    }
  }
  .hero-rail {
    position: absolute; top: 50%; right: calc(var(--frame) + 26px);
    transform: translateY(-50%);
    font-size: clamp(15px, 1.6vw, 21px);
    letter-spacing: .9em;
    color: var(--kin-faint);
    z-index: 2;
  }
  @media (max-width: 760px) { .hero-rail { display: none; } }

  .hero-inner {
    position: relative; z-index: 2;
    padding: 0 var(--gutter) clamp(72px, 12vh, 140px);
    width: 100%;
  }
  .hero-title {
    font-size: clamp(48px, 9.4vw, 138px);
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--silk);
    margin: 14px 0 20px -4px;
    white-space: nowrap;
  }
  .hero-sub {
    max-width: 44ch;
    font-size: clamp(15px, 1.4vw, 17.5px);
    color: var(--silk-dim);
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 36px; }

  .btn-gold, .btn-ghost {
    display: inline-block;
    padding: 15px 34px;
    font-size: 11px; font-weight: 600;
    letter-spacing: .32em; text-transform: uppercase;
    transition: background .4s var(--ease), color .4s, border-color .4s;
  }
  .btn-gold { background: var(--kin); color: #14100a; }
  .btn-gold:hover { background: var(--kin-bright); }
  .btn-ghost { border: 1px solid var(--line); color: var(--silk); }
  .btn-ghost:hover { border-color: var(--kin); color: var(--kin-bright); }

  .scroll-cue {
    position: absolute; z-index: 2;
    right: var(--gutter); bottom: clamp(72px, 12vh, 140px);
    display: flex; flex-direction: column; align-items: center; gap: 14px;
  }
  .scroll-cue .label { writing-mode: vertical-rl; letter-spacing: .5em; }
  .scroll-cue i { width: 1px; height: 56px; background: var(--kin-faint); position: relative; overflow: hidden; display: block; }
  .scroll-cue i::after {
    content: ""; position: absolute; left: 0; top: -40%;
    width: 100%; height: 40%; background: var(--kin-bright);
    animation: cueDrop 2.4s var(--ease) infinite;
  }
  @keyframes cueDrop { to { top: 110%; } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue i::after { animation: none; } }
  @media (max-width: 760px) { .scroll-cue { display: none; } }

  .hero-dust { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }

  /* ============ CHAPTER RAIL ============
     Lives entirely inside the left margin: diamonds in one slim column,
     the active chapter's name set vertically beside it (the site's
     vertical-writing motif). Nothing from the rail may enter the content
     column — labels are vertical precisely so their width stays ~12px. */
  .chapters {
    position: fixed; z-index: 95;
    left: calc(var(--frame) + 8px); top: 50%;
    translate: 0 -50%;
    display: flex; flex-direction: column; gap: 24px;
  }
  @media (max-width: 1320px) { .chapters { display: none; } }
  .chapters a {
    position: relative;
    width: 15px; height: 15px;
    display: grid; place-items: center;
  }
  .chapters i {
    width: 7px; height: 7px;
    border: 1px solid var(--kin-faint);
    transform: rotate(45deg);
    transition: background .4s, border-color .4s, box-shadow .4s;
  }
  .chapters span {
    position: absolute; right: 19px; top: 50%;
    translate: 0 -50%;
    /* bottom-to-top: the left-spine convention for rotated Latin.
       (Top-to-bottom tategaki is reserved for the upright kanji rails.) */
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    font-size: 9.5px; font-weight: 600; letter-spacing: .34em; text-transform: uppercase;
    color: var(--silk-dim);
    opacity: 0;
    transition: opacity .4s var(--ease), color .4s;
    pointer-events: none;
  }
  .chapters a:hover span { opacity: 1; }
  .chapters a.on i {
    background: var(--kin); border-color: var(--kin-bright);
    box-shadow: 0 0 10px rgba(194,160,97,.5);
  }
  .chapters a.on span { opacity: 1; color: var(--kin-bright); }
  /* only one vertical label at a time: hovering the rail yields to the hover */
  .chapters:hover a.on:not(:hover) span { opacity: 0; }

  /* ============ DOCTRINE ============ */
  .doctrine {
    position: relative;
    padding: var(--s9) var(--gutter);
    background: var(--roiro);
    overflow: hidden;
  }
  .doctrine-kanji {
    position: absolute; top: 50%; right: -4%;
    transform: translateY(-50%);
    font-size: clamp(220px, 34vw, 520px);
    line-height: 1;
    color: rgba(194,160,97,.045);
    pointer-events: none;
    user-select: none;
  }
  .doctrine-inner { max-width: 880px; margin-inline: auto; position: relative; }
  .doctrine-line {
    font-size: clamp(34px, 5.4vw, 72px);
    margin: 22px 0 34px;
  }
  .doctrine-copy { max-width: 58ch; color: var(--silk-dim); font-size: 16.5px; }
  .doctrine-facts {
    display: flex; gap: clamp(36px, 7vw, 96px);
    margin-top: var(--s6);
    padding-top: var(--s4);
    border-top: 1px solid var(--line-soft);
  }
  .doctrine-facts div { display: flex; flex-direction: column; gap: 10px; }
  .doctrine-facts strong { font-size: clamp(34px, 4vw, 52px); color: var(--kin); font-weight: 400; }

  /* ============ REGISTER ============ */
  .register { padding: var(--s9) var(--gutter); background: var(--urushi); }
  .register-head { max-width: 1280px; margin: 0 auto var(--s8); }
  .register-title { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s4); }
  .register-year { font-size: 15px; letter-spacing: .5em; color: var(--kin-faint); }
  @media (max-width: 760px) { .register-year { display: none; } }
  .register-head h2 { font-size: clamp(38px, 5.6vw, 76px); margin-top: 18px; }
  .register-note { color: var(--silk-dim); margin-top: 16px; max-width: 46ch; }

  .work {
    display: grid;
    max-width: 1280px;
    margin: 0 auto var(--s8);
    gap: var(--s5);
    align-items: center;
  }
  @media (min-width: 900px) {
    .work--portrait { grid-template-columns: 5fr 6fr; }
    .work--wide { grid-template-columns: 7fr 4fr; }
    .work--wide:nth-of-type(even) { grid-template-columns: 4fr 7fr; }
    .work--portrait:nth-of-type(even) { grid-template-columns: 6fr 5fr; }
    .work:nth-of-type(even) .work-media { order: 2; }
  }
  .work-media {
    overflow: hidden;
    background: var(--void);
    border: 1px solid var(--line-soft);
  }
  .work-media img {
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.06);
    transition: filter 1.2s var(--ease);
    filter: brightness(.92);
    will-change: transform;
  }
  .work:hover .work-media img { filter: brightness(1.05); }
  .work--portrait .work-media { aspect-ratio: 3 / 3.6; }
  .work--wide .work-media { aspect-ratio: 16 / 10; }

  .work-no { font-size: 15px; letter-spacing: .3em; color: var(--kin); }
  .work-no span { color: var(--silk-faint); }
  .work-name {
    font-size: clamp(34px, 4.6vw, 60px);
    margin: 10px 0 8px;
    display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap;
  }
  .work-kanji { font-size: .55em; color: var(--kin-faint); }
  .work-lede { color: var(--silk-dim); max-width: 46ch; margin-top: 18px; font-size: 15.5px; }
  .work-row {
    display: flex; align-items: center; gap: 22px;
    margin-top: 26px;
  }
  .work-price { font-family: var(--display); font-size: 21px; letter-spacing: .06em; color: var(--silk); }
  .work-status {
