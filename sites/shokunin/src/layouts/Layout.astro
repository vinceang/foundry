---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Marcellus&family=Manrope:wght@300;400;600;700&family=Zen+Old+Mincho:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="cursor" aria-hidden="true"></div>
    <div class="hud-frame" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Shokunin — home">
        <span class="brand-seal" aria-hidden="true"><span>職</span></span>
        <span class="brand-word">Shokunin</span>
      </a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#register">The Register</a>
        <a href="/#ateliers">Ateliers</a>
        <a href="/#commission">Commission</a>
        <a class="nav-cta" href="/#commission">Petition</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-grid">
        <div>
          <p class="footer-mark">Shokunin</p>
          <p style="margin-top: 16px; max-width: 36ch; font-size: 13.5px; color: var(--silk-dim);">
            Bespoke samurai ateliers. Twelve works a year,
            entered into the Register and released by petition.
          </p>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">The House</h4>
          <ul>
            <li><a href="/#register">The Register</a></li>
            <li><a href="/#ateliers">Ateliers</a></li>
            <li><a href="/#commission">Commission</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">Audiences</h4>
          <ul>
            <li>Kyōto — by appointment</li>
            <li>Geneva — by appointment</li>
            <li>New York — by appointment</li>
          </ul>
        </div>
        <div class="footer-col">
          <h4 class="label label--dim">Correspondence</h4>
          <ul>
            <li><a href="mailto:register@shokunin.example">register@shokunin.example</a></li>
            <li>Replies within three days</li>
          </ul>
        </div>
      </div>
      <div class="footer-legal">
        <span>© 2026 Shokunin. A fictional house, presented as a design study.</span>
        <span>職人 — one craft, one life</span>
      </div>
    </footer>

    <script>
      // ---- reveal on scroll ----
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.16, rootMargin: '0px 0px -6% 0px' }
      );
      document.querySelectorAll('.rv, .rv-line').forEach((el) => io.observe(el));

      // ---- custom cursor ----
      const fine = matchMedia('(pointer: fine)').matches;
      const noMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (fine && !noMotion) {
        document.documentElement.classList.add('cursor-on');
        const cur = document.querySelector('.cursor') as HTMLElement;
        let x = 0, y = 0, cx = 0, cy = 0;
        addEventListener('mousemove', (e) => { x = e.clientX; y = e.clientY; });
        const loop = () => {
          cx += (x - cx) * 0.22;
          cy += (y - cy) * 0.22;
          cur.style.translate = `${cx}px ${cy}px`;
          requestAnimationFrame(loop);
        };
        loop();
        document.querySelectorAll('a, button, [data-cursor]').forEach((el) => {
          el.addEventListener('mouseenter', () => cur.classList.add('is-link'));
          el.addEventListener('mouseleave', () => cur.classList.remove('is-link'));
        });
      }

      // ---- gentle parallax on marked media ----
      if (!noMotion) {
        const px = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));
        if (px.length) {
          let ticking = false;
          const update = () => {
            const vh = innerHeight;
            for (const el of px) {
              const r = el.getBoundingClientRect();
              if (r.bottom < -80 || r.top > vh + 80) continue;
              const p = (r.top + r.height / 2 - vh / 2) / vh; // -0.5 .. 0.5
              const depth = parseFloat(el.dataset.parallax || '24');
              el.style.transform = `translateY(${(-p * depth).toFixed(2)}px) scale(1.06)`;
            }
            ticking = false;
          };
          addEventListener('scroll', () => {
            if (!ticking) { ticking = true; requestAnimationFrame(update); }
          }, { passive: true });
          update();
        }
      }
    </script>
  </body>
</html>
