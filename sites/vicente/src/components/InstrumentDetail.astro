---
import "../styles/global.css";
import "../styles/instrument-detail.css";
import { strings, type Locale } from "../i18n";
import mark from "../assets/mark.svg?raw";

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = strings[locale];
const home = locale === "en" ? "/" : "/es/";
const otherHref = locale === "en" ? "/es/guitarras/concierto/" : "/guitars/concierto/";

const copy = locale === "en" ? {
  title: "La Clásica · Concierto — Casa Vicente",
  description: "The Casa Vicente concert classical guitar: German spruce, Indian rosewood and French polish, built by Cesar Vicente in Granada.",
  back: "Back to the guitars",
  eyebrow: "La Clásica · Concierto",
  h1a: "Built for the ",
  h1accent: "far wall",
  h1b: ", voiced for the first row.",
  intro: "La Clásica is the house concert guitar: immediate under the hand, even across the register, and capable of carrying a quiet phrase to the back of a hall without hardening its voice.",
  price: "€12,800",
  availability: "Built to order · current bench: next year",
  makerLabel: "Built by",
  maker: "Cesar Vicente",
  cta: "Begin a commission",
  voiceLabel: "The voice · La voz",
  voiceH2a: "Projection without ",
  voiceAccent: "force",
  voiceH2b: ".",
  voiceP1: "Cesar leaves the German spruce top fractionally more alive around the lower bout, then tunes the fan braces one by one until the bass opens without swallowing the trebles. The result is not volume for its own sake. It is distance with shape intact.",
  voiceP2: "The attack is clear but never brittle. Sustained notes bloom rather than flatten, and the third string is worked until it crosses from wound to plain without a change of character.",
  specLabel: "Specification · Especificación",
  specs: [
    ["Top", "Master-grade German spruce"],
    ["Back & sides", "Indian rosewood"],
    ["Neck", "Spanish cedar · ebony reinforcement"],
    ["Fingerboard", "African ebony"],
    ["Scale", "650 mm"],
    ["Nut width", "52 mm"],
    ["Bracing", "Seven-fan, individually voiced"],
    ["Finish", "Hand-rubbed French polish"],
    ["Case", "Fitted Hiscox Pro II"],
  ],
  woodLabel: "The materials · Los materiales",
  woodH2a: "Ten years in the roof. ",
  woodAccent: "One year on the bench.",
  woodP: "The soundboard is selected from spruce billets stored beneath the workshop roof for at least a decade. The rosewood is chosen for stiffness and ring rather than figure alone. Each set is paired by ear before it is paired by grain.",
  commissionLabel: "Commission · Encargo",
  commissionH2a: "The same model. ",
  commissionAccent: "Your hands.",
  commissionP: "String height, neck profile and tonal balance are decided with the player. Tell us your repertoire, your touch and the rooms you play. The guitar is built around those answers.",
  note: "Worldwide delivery from Granada · insured hard case included",
} : {
  title: "La Clásica · Concierto — Casa Vicente",
  description: "La guitarra clásica de concierto de Casa Vicente: abeto alemán, palosanto de India y goma laca, construida por Cesar Vicente en Granada.",
  back: "Volver a las guitarras",
  eyebrow: "La Clásica · Concierto",
  h1a: "Hecha para la ",
  h1accent: "última fila",
  h1b: ", afinada para la primera.",
  intro: "La Clásica es la guitarra de concierto de la casa: inmediata bajo la mano, equilibrada en todo el registro y capaz de llevar una frase silenciosa hasta el fondo de una sala sin endurecer la voz.",
  price: "12.800 €",
  availability: "Construida por encargo · banco actual: el próximo año",
  makerLabel: "Construida por",
  maker: "Cesar Vicente",
  cta: "Iniciar un encargo",
  voiceLabel: "La voz · The voice",
  voiceH2a: "Proyección sin ",
  voiceAccent: "fuerza",
  voiceH2b: ".",
  voiceP1: "Cesar deja la tapa de abeto alemán apenas más viva alrededor del lóbulo inferior y afina las varetas del abanico una a una hasta que el grave se abre sin tragarse los agudos. El resultado no es volumen por sí mismo. Es distancia sin perder la forma.",
  voiceP2: "El ataque es claro, nunca quebradizo. Las notas sostenidas florecen en lugar de aplanarse, y la tercera cuerda se trabaja hasta que el paso de entorchada a lisa no cambia el carácter.",
  specLabel: "Especificación · Specification",
  specs: [
    ["Tapa", "Abeto alemán de calidad maestra"],
    ["Fondo y aros", "Palosanto de India"],
    ["Mástil", "Cedro español · refuerzo de ébano"],
    ["Diapasón", "Ébano africano"],
    ["Tiro", "650 mm"],
    ["Ancho de cejuela", "52 mm"],
    ["Varetaje", "Abanico de siete, afinado individualmente"],
    ["Acabado", "Goma laca aplicada a muñequilla"],
    ["Estuche", "Hiscox Pro II a medida"],
  ],
  woodLabel: "Los materiales · The materials",
  woodH2a: "Diez años bajo el tejado. ",
  woodAccent: "Uno en el banco.",
  woodP: "La tapa se elige entre tablones de abeto guardados bajo el tejado del taller durante al menos una década. El palosanto se selecciona por rigidez y resonancia, no solo por dibujo. Cada juego se empareja primero por oído y después por veta.",
  commissionLabel: "Encargo · Commission",
  commissionH2a: "El mismo modelo. ",
  commissionAccent: "Sus manos.",
  commissionP: "La altura de cuerdas, el perfil del mástil y el equilibrio tonal se deciden con el guitarrista. Cuéntenos su repertorio, su pulsación y las salas donde toca. La guitarra se construye alrededor de esas respuestas.",
  note: "Envío mundial desde Granada · estuche rígido asegurado incluido",
};
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="alternate" hreflang="en" href="/guitars/concierto/" />
    <link rel="alternate" hreflang="es" href="/es/guitarras/concierto/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="grain" aria-hidden="true"></div>
    <header class="site-header instrument-header">
      <a class="brand-mark" href={home} set:html={mark} aria-label="Casa Vicente" />
      <div class="header-right">
        <a class="detail-back small-caps" href={`${home}#guitarras`}>← {copy.back}</a>
        <div class="lang-toggle small-caps" aria-label="Language">
          <a href="/guitars/concierto/" class={locale === "en" ? "active" : ""} lang="en">EN</a>
          <span class="sep">·</span>
          <a href="/es/guitarras/concierto/" class={locale === "es" ? "active" : ""} lang="es">ES</a>
        </div>
      </div>
    </header>

    <main>
      <section class="instrument-hero">
        <div class="instrument-hero-media">
          <img src="/guitar-clasica.png" alt="La Clásica concert guitar by Casa Vicente" />
        </div>
        <div class="instrument-hero-copy">
          <p class="label">{copy.eyebrow}</p>
          <h1>{copy.h1a}<em>{copy.h1accent}</em>{copy.h1b}</h1>
          <p class="instrument-intro">{copy.intro}</p>
          <div class="instrument-purchase">
            <div>
              <div class="instrument-price">{copy.price}</div>
              <div class="instrument-availability">{copy.availability}</div>
            </div>
            <a class="btn" href={`${home}#encargo`}><span>{copy.cta} →</span></a>
          </div>
          <a class="instrument-maker" href={`${home}luthier/cesar/`}>
            <img src="/luthier-cesar.png" alt="Cesar Vicente" />
            <span><small>{copy.makerLabel}</small><strong>{copy.maker}</strong></span>
          </a>
        </div>
      </section>

      <section class="instrument-voice">
        <div class="container instrument-prose-grid">
          <div>
            <p class="label">{copy.voiceLabel}</p>
            <h2>{copy.voiceH2a}<em>{copy.voiceAccent}</em>{copy.voiceH2b}</h2>
          </div>
          <div class="instrument-copy"><p>{copy.voiceP1}</p><p>{copy.voiceP2}</p></div>
        </div>
      </section>

      <section class="instrument-specs">
        <div class="container">
          <p class="label on-light">{copy.specLabel}</p>
          <div class="spec-list">
            {copy.specs.map(([key, value]) => <div class="spec-row"><span>{key}</span><strong>{value}</strong></div>)}
          </div>
        </div>
      </section>

      <section class="instrument-wood">
        <div class="instrument-wood-image"><img src="/workshop.png" alt="Tonewoods aging in the Casa Vicente workshop" /></div>
        <div class="instrument-wood-copy">
          <p class="label">{copy.woodLabel}</p>
          <h2>{copy.woodH2a}<em>{copy.woodAccent}</em></h2>
          <p>{copy.woodP}</p>
        </div>
      </section>

      <section class="instrument-commission" id="encargo">
        <p class="label on-light">{copy.commissionLabel}</p>
        <h2>{copy.commissionH2a}<em>{copy.commissionAccent}</em></h2>
        <p>{copy.commissionP}</p>
        <a class="btn" href="mailto:atelier@casavicente.example"><span>{copy.cta} →</span></a>
        <div class="instrument-note">{copy.note}</div>
      </section>
    </main>

    <footer class="instrument-footer">
      <a class="brand-mark" href={home} set:html={mark} aria-label="Casa Vicente" />
      <span>Cuesta de Gomérez · Granada · ES</span>
      <a href={otherHref}>{locale === "en" ? "Ver en español" : "View in English"} →</a>
    </footer>
  </body>
</html>
