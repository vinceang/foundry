      /* ---------- entrances, tied to scroll position ----------
         Fade-up-on-scroll is banned in this phase because it is a TRIGGER: it
         fires once at a threshold and cannot be undone. These are the same idea
         built as a CONTROLLER — every one is driven by a view() timeline, so
         scrolling back un-resolves it exactly. Reversible, user-paced, and
         consistent with the grammar rule rather than an exception to it.

         The material idea is the subject's own: things arrive the way water
         arrives in a pan — filling from the bottom edge, not floating up from
         nowhere. Plates wipe upward, measures rise into place, rows fill in
         sequence.

         No JS. Where view() timelines are unsupported the default state is the
         finished composition, so nothing is ever hidden by a missing feature. */
      @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
          @keyframes rise {
            from {
              opacity: 0;
              transform: translateY(18px);
            }
            to {
              opacity: 1;
              transform: none;
            }
          }
          /* the plate fills like a pan: the image is uncovered from the bottom */
          @keyframes fill {
            from {
              clip-path: inset(72% 0 0 0);
            }
            to {
              clip-path: inset(0 0 0 0);
            }
          }
          @keyframes settle {
            from {
              opacity: 0;
              transform: translateY(10px);
            }
            to {
              opacity: 1;
              transform: none;
            }
          }

          /* the chapter measure — the trade's own figure — rises first */
          .ch__m,
          .ch .pond-name {
            animation-name: rise;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 8% cover 26%;
          }
          .ch__h {
            animation-name: rise;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 12% cover 30%;
          }

          /* plates fill from the bottom edge */
          .ch .plate img,
          .salt__img {
            animation-name: fill;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 4% cover 24%;
          }

          /* the yield table fills row by row, because it is a record being read
             down, and the stagger is the reading order */
          .tbl--yield tbody tr {
            animation-name: settle;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 6% cover 30%;
          }
          .tbl--yield tbody tr:nth-child(2) { animation-range: entry 9% cover 33%; }
          .tbl--yield tbody tr:nth-child(3) { animation-range: entry 12% cover 36%; }
          .tbl--yield tbody tr:nth-child(4) { animation-range: entry 15% cover 39%; }
          .tbl--yield tbody tr:nth-child(5) { animation-range: entry 18% cover 42%; }

          /* the two salts, one after the other, since the section argues one
             against the other */
          .two .salt:first-child {
            animation-name: settle;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 6% cover 28%;
          }
          .two .salt:last-child  { animation: settle linear both; animation-timeline: view(); animation-range: entry 13% cover 35%; }

          /* the three paludiers, left to right */
          .three .plate:nth-child(1) {
            animation-name: settle;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 6% cover 26%;
          }
          .three .plate:nth-child(2) {
            animation-name: settle;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 10% cover 30%;
          }
          .three .plate:nth-child(3) {
            animation-name: settle;
            animation-duration: 1ms;
            animation-timing-function: linear;
            animation-fill-mode: both;
            animation-timeline: view();
            animation-range: entry 14% cover 34%;
          }
        }
      }

      /* ---------- chapters ---------- */
      .ch {
        padding: var(--s7) 0 var(--s6);
      }
      .ch__m {
        margin: 0;
      }
      .ch__body {
        margin-top: var(--s5);
      }
      .ch__h {
        font-size: clamp(34px, 4.6vw, 68px);
        font-variation-settings: "wdth" 94, "opsz" 72;
        max-width: 20ch;
        margin-bottom: var(--s3);
      }
      .ch__h--sm {
        font-size: clamp(28px, 3vw, 42px);
        max-width: 22ch;
      }
      .ch__lead {
        font-size: 19px;
        max-width: 54ch;
        margin-bottom: var(--s4);
      }
      .mono {
        font-family: var(--mono);
        font-variant-numeric: tabular-nums;
      }

      /* placeholders: real materials from the palette, cut to the intended
         crop, so the critique loop judges composition honestly. Replaced by
         generated plates in the imagery pass. */
      .plate {
        margin: var(--s5) 0 0;
      }
      .plate figcaption {
        margin-top: var(--s1);
        display: block;
      }
      .plate figcaption strong {
        display: block;
        font-family: var(--display);
        font-size: 18px;
        font-weight: 400;
      }
      .plate img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: var(--argile);
      }
      .plate--wide img {
        aspect-ratio: 21 / 9;
      }
      .plate--tall img {
        aspect-ratio: 2 / 3;
      }
      .ch--split .plate img {
        aspect-ratio: 3 / 2;
      }
      .salt__img {
        width: 100%;
        aspect-ratio: 3 / 2;
        object-fit: cover;
        margin-bottom: var(--s2);
        background: var(--argile);
      }
      .plate--wide {
        width: 100%;
      }

      /* le sel — where in the water each salt forms */
      .two {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--s5);
        margin-top: var(--s5);
      }
      .salt {
        margin: 0;
      }
      .salt__dia {
        position: relative;
        height: 132px;
        background: var(--argile);
        border-bottom: 5px solid var(--vase);
        overflow: hidden;
      }
      .salt__dia::after {
        content: "";
        position: absolute;
        inset: 38% 0 0 0;
        background: var(--fleur);
        opacity: 0.9;
      }
      .salt__surface,
      .salt__floor {
        position: absolute;
        left: 0;
        right: 0;
        z-index: 2;
        height: 9px;
        background: var(--sel);
        opacity: 0.18;
      }
      .salt__surface {
        top: 38%;
      }
      .salt__floor {
        bottom: 0;
        height: 14px;
      }
      .salt__surface--on,
      .salt__floor--on {
        opacity: 1;
      }
      .salt__h {
        font-size: 27px;
        margin: var(--s2) 0 var(--s1);
      }
      .salt__price {
        font-family: var(--mono);
        border-top: 1px solid var(--argile-deep);
        padding-top: var(--s1);
      }

      /* le las */
      .ch--split {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: var(--s5);
        align-items: center;
        width: min(1240px, 100% - var(--s4) * 2);
        margin-inline: auto;
        padding: var(--s6) 0;
      }
      .ch--split .plate {
        margin: 0;
      }

      .three {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--s3);
        margin-top: var(--s5);
      }
      .three .plate {
        margin: 0;
      }

      /* ---------- la récolte ---------- */
      .ch--order {
        background: var(--argile);
        padding-bottom: var(--s7);
      }
      .tbl--yield {
        width: 100%;
        margin-bottom: var(--s6);
      }
      .tbl--yield th,
      .tbl--yield td {
        border-bottom-color: var(--vase);
      }
      .yield__note {
        color: var(--vase-ink);
        font-family: var(--body);
        font-size: 14px;
      }

      .order {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--s3) var(--s4);
        max-width: 780px;
        background: var(--glare);
        padding: var(--s4);
        border: 1px solid var(--vase);
      }
      .order__h {
        grid-column: 1 / -1;
        font-size: 30px;
        margin: 0;
      }
      .field {
        display: flex;
        flex-direction: column;
        gap: var(--s1);
      }
      .field--wide,
      .order__foot,
      .order__fine,
      .order__sent {
        grid-column: 1 / -1;
      }
      .order input,
      .order select,
      .order textarea {
        font-family: var(--mono);
        font-size: 15px;
        padding: var(--s1) var(--s2);
        border: 1px solid var(--vase);
        background: var(--sel);
        color: var(--encre);
        border-radius: 0;
      }
      .order textarea {
        font-family: var(--body);
        resize: vertical;
      }
      .seg {
        display: flex;
        gap: var(--s1);
      }
      .seg label {
        flex: 1;
      }
      .seg input {
        position: absolute;
        opacity: 0;
        width: 0;
      }
      .seg span {
        display: block;
        text-align: center;
        font-family: var(--mono);
        font-size: 13px;
        padding: var(--s1) var(--s2);
        border: 1px solid var(--vase);
        cursor: pointer;
      }
      .seg input:checked + span {
        background: var(--encre);
        border-color: var(--encre);
        color: var(--sel);
      }
      .seg input:focus-visible + span {
        outline: 2px solid var(--fleur);
        outline-offset: 3px;
      }
      .err {
        margin: 0;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--fleur-alert);
      }
      .order [aria-invalid="true"] {
        border-color: var(--fleur-alert);
        border-width: 2px;
      }
      .order__foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s3);
        border-top: 1px solid var(--argile-deep);
        padding-top: var(--s3);
        flex-wrap: wrap;
      }
      .order__total {
        margin: 0;
        display: flex;
        align-items: baseline;
        gap: var(--s2);
      }
      .order__total .mono {
        font-size: 27px;
        display: inline-block;
      }
      .order__total .mono.is-tick {
        animation: tick 260ms var(--ease);
      }
      @keyframes tick {
        0% {
          transform: translateY(-3px);
          color: var(--fleur-deep);
        }
        100% {
          transform: none;
          color: var(--encre);
        }
      }
      .btn {
        font-family: var(--mono);
        font-size: 13px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: var(--s2) var(--s4);
        background: var(--fleur-deep);
        color: var(--sel);
        border: 1px solid var(--fleur-deep);
        cursor: pointer;
      }
      .btn:hover {
        background: var(--encre);
        border-color: var(--encre);
      }
      .btn[disabled] {
        opacity: 0.55;
        cursor: progress;
      }
      /* running text, never a tracked micro-label: five lines of 11px
         uppercase at .32em is a legibility failure, not a detail */
      .order__fine {
        margin: 0;
        font-size: 13px;
        line-height: 1.65;
        color: var(--vase-ink);
        max-width: 62ch;
      }
      .order__fine .mono {
        font-size: 12.5px;
        color: var(--encre);
      }
      .order__sent {
        margin: 0;
        font-family: var(--body);
        font-size: 16px;
        border-top: 1px solid var(--argile-deep);
        padding-top: var(--s2);
      }

      .foot {
        border-top: 1px solid var(--argile-deep);
        padding: var(--s4) 0;
      }
      .foot__in {
        display: flex;
        justify-content: space-between;
        gap: var(--s3);
        flex-wrap: wrap;
      }
      .foot p {
        margin: 0;
        font-size: 13px;
      }

      @media (max-width: 900px) {
        .cascade__grid {
          grid-template-columns: 1fr;
          gap: var(--s3);
        }
        .cascade[data-live="true"] {
          height: 240vh;
        }
        .two,
        .three,
        .ch--split,
        .order {
          grid-template-columns: 1fr;
        }
        .ch {
          padding: var(--s6) 0 var(--s5);
        }
        .yield__note {
          display: none;
        }
      }

      @media (max-width: 620px) {
        /* the nav wrapped to five lines and buried the instrument under the
           sticky header. One row that scrolls, and the header stays one line. */
        .top__in {
          flex-direction: column;
          align-items: stretch;
          gap: var(--s1);
          padding: var(--s1) 0 0;
        }
        .top nav {
          flex-wrap: nowrap;
          overflow-x: auto;
          gap: var(--s2);
          padding-bottom: var(--s1);
          scrollbar-width: none;
        }
        .top nav::-webkit-scrollbar {
          display: none;
        }
        /* 19px tall is not a thumb target. Padding rather than font-size, so
           the tracked-caps rhythm of the row is untouched. */
        .top nav a {
          white-space: nowrap;
          padding: 11px 2px;
          display: inline-block;
        }
        .top nav {
          padding-bottom: 0;
        }
        .weather button {
          padding: 12px var(--s3);
        }
        .mark {
          padding: 6px 0;
          display: inline-block;
        }
        section[id] {
          scroll-margin-top: 96px;
        }

        /* the instrument is the reason to visit, so on a phone it gets the top
           of the screen at full width — section, then readout, then the plan
           as a locator. Squeezing the desktop grid made it a thumbnail. */
        .cascade__grid {
          grid-template-columns: 1fr;
          grid-template-areas:
            "sect"
            "read"
            "plan";
          grid-template-rows: auto auto auto;
          gap: var(--s3);
        }
        .cascade__grid .sect {
          margin: 0;
        }
        /* the stacked frame has to fit inside one clipped viewport, or the
           plan — the primary control — is scrolled out of a sticky box and
           can never be reached. Measured: the stack was 1140px in an 844px
           frame, so the pans were invisible on a phone. */
        .sect__pan {
          min-height: 128px;
        }
        .read .measure {
          font-size: 44px;
        }
        .figs {
          gap: var(--s1);
          margin: var(--s2) 0;
        }
        .note {
          font-size: 14px;
          min-height: 0;
        }
        .weather {
          padding-top: var(--s1);
        }
        .weather__msg {
          font-size: 13px;
        }
        .plan__cap {
          margin-top: var(--s1);
        }
        .cascade__grid .plan {
          margin-top: var(--s2);
        }
        .cascade__grid .plan__svg {
          min-height: 132px;
        }
        .figs > div {
          gap: var(--s1);
        }
        /* No pin on a phone. A 100dvh frame cannot hold the section, the
           readout and the plan stacked — measured at 1140px in an 844px box,
           which clipped the plan away entirely and put the primary control
           out of reach. The instrument still scrubs from the section's own
           position, so nothing is lost but the freeze. */
        .cascade[data-live="true"] {
          height: auto;
        }
        .cascade[data-live="true"] .cascade__sticky {
          position: static;
          height: auto;
          overflow: visible;
          padding-block: var(--s5) var(--s4);
          align-items: stretch;
        }
        .plate--bleed {
          height: 62vh;
          min-height: 340px;
        }
        /* the row scrolls, so fade the right edge — otherwise it stops at
           "Le las" and La récolte looks like it does not exist */
        .top nav {
          -webkit-mask-image: linear-gradient(90deg, #000 82%, transparent);
          mask-image: linear-gradient(90deg, #000 82%, transparent);
        }
      }
    </style>
  </body>
</html>
