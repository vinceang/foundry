      .cascade[data-live="true"] .cascade__sticky {
        position: sticky;
        top: 0;
        height: 100dvh;
        display: flex;
        align-items: center;
        /* 78 clears the header, +22 absorbs the drift range below */
        padding-block: 100px var(--s3);
        overflow: hidden;
      }
      /* section large left, readout right, plan a locator beneath it */
      .cascade__grid {
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        grid-template-areas:
