        stroke: var(--fleur-deep);
      }
      /* The focal moment: rain arrives in seconds, recovery takes six days.
         The default (recovery) is slow and staggered down the chain; the
         .is-rain rule below overrides it with a fast, near-simultaneous flood.
         A transition takes the duration in effect when the value changes, so
         adding the class floods fast and removing it dries slowly — the
         asymmetry is the craft's actual risk profile, not a flourish. */
      .pan {
        transition:
          fill 1100ms var(--ease) calc(var(--i, 0) * 110ms),
          filter 0.32s var(--ease);
        /* the swelling pan lifts off the ground slightly, so the bulge reads
           as volume arriving rather than a rectangle getting bigger */
        filter: drop-shadow(0 calc(var(--swell, 0) * 5px) calc(var(--swell, 0) * 9px) rgb(34 32 28 / calc(var(--swell, 0) * 0.28)));
      }
      .pan-g .pan {
        /* widen the tap target outward from the drawn edge; the pans shrink
