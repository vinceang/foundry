---
import "../styles/global.css";
import { STAGES, brineColour, CRYSTAL_BE, OEILLETS, SALT } from "../cascade.mjs";

const nav = [
  ["#saline", "La saline"],
  ["#cascade", "La cascade"],
  ["#sel", "Le sel"],
  ["#las", "Le las"],
  ["#paludiers", "Les paludiers"],
  ["#recolte", "La récolte"],
];

// Plan geometry for the pond sequence. Pans are cut by eye into clay, so the
// shapes are deliberately irregular — a surveyed grid would be a lie.
// The pans step down and to the right, because the water does — a saline is
// cut so gravity moves the brine and nothing else has to.
export const PAN_CENTRES = [];
const PANS = [
  { x: 10, y: 8, w: 232, h: 186, skew: 7 },
  { x: 262, y: 54, w: 176, h: 150, skew: -5 },
  { x: 458, y: 96, w: 136, h: 116, skew: 8 },
  { x: 614, y: 132, w: 104, h: 88, skew: -4 },
  { x: 738, y: 162, w: 78, h: 64, skew: 5 },
];
PANS.forEach((p) => PAN_CENTRES.push({ x: p.x + p.w / 2, y: p.y + p.h / 2 }));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Saline de Kervalet — sel de Guérande, récolté à la main depuis 1743</title>
    <meta
      name="description"
      content="Une saline sur les marais salants de Guérande. Soixante œillets taillés dans l'argile, aucune pompe, aucune chaleur. Trois semaines d'eau de mer pour un sel."
    />
  </head>
  <body>
    <a class="skip" href="#cascade">Aller à la cascade</a>

    <header class="top">
      <div class="wrap top__in">
        <a class="mark" href="#top">Saline&nbsp;de&nbsp;Kervalet</a>
        <nav aria-label="Sections">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
      </div>
    </header>

    <main id="top">
      <!-- ---------------------------------------------- hero -->
      <section class="hero">
        <div class="wrap">
          <p class="measure hero__m">
            3.5<span class="measure__unit">°Bé</span>
          </p>
          <p class="pond-name">L'Atlantique · l'eau entre ici</p>
          <h1 class="hero__h">
            The water does the work.<br />We only decide how fast.
          </h1>
          <p class="hero__sub">
            Sixty œillets cut into blue clay at Guérande, worked by the same
            family since 1743. No pumps, no heat, no machinery of any kind. The
            only energy in this system is the tide that fills it and the sun
            that empties it. Seawater enters at three and a half degrees Baumé
            and leaves, twenty-one days later, as salt.
          </p>
        </div>
        <figure class="plate plate--bleed">
          <img
            src="/images/aerial.jpg"
            srcset="/images/aerial-800.jpg 800w, /images/aerial.jpg 1536w"
            sizes="100vw"
            width="1536"
            height="1024"
            alt="The saline from above: shallow clay pans in a hand-cut grid, the water deep green in the largest, pale sand in the middle ones and vivid rose in the smallest, with white heaps of harvested salt on the banks."
            fetchpriority="high"
          />
          <figcaption class="wrap">
            <span class="label">The saline from above · noon · three concentrations in one frame</span>
            <span class="label hero__cue">Scroll to walk the water through</span>
          </figcaption>
        </figure>
      </section>

      <!-- ---------------------------------------------- la cascade (signature) -->
      <section
        id="cascade"
        class="cascade"
        data-cascade
        data-pans={JSON.stringify(PAN_CENTRES)}
      >
        <div class="cascade__sticky">
          <div class="wrap cascade__grid">
            <!-- the section is the argument: the pan gets shallower as the
                 brine gets stronger, and that is what a caption cannot carry -->
            <figure class="sect">
              <div class="sect__pan">
                <div class="sect__water" data-out="water"></div>
                <div class="sect__crust" data-out="crust"></div>
                <span class="sect__rule sect__rule--top"><i class="label">40 cm</i></span>
                <span class="sect__rule sect__rule--now" data-out="rule"
                  ><i class="label" data-out="depth2">40 cm</i></span
                >
              </div>
              <figcaption class="label"
                >Section through one pan · depth falls as the brine
                concentrates</figcaption
              >
            </figure>

            <!-- readout, with the plan as a locator beneath it -->
            <div class="read">
              <p class="measure">
                <span data-out="be">{STAGES[0].be.toFixed(1)}</span
                ><span class="measure__unit">°Bé</span>
              </p>
              <p class="pond-name" data-out="name">{STAGES[0].name}</p>

              <dl class="figs">
                <div>
                  <dt class="label">Profondeur</dt>
                  <dd data-out="depth">{STAGES[0].depth} cm</dd>
                </div>
                <div>
                  <dt class="label">Jour</dt>
                  <dd data-out="day">{STAGES[0].day}</dd>
                </div>
              </dl>

              <p class="note" data-out="note">{STAGES[0].note}</p>

              <div class="weather" data-weather hidden>
                <span class="label">Temps</span>
                <div class="weather__set" role="group" aria-label="Météo sur la saline">
                  <button type="button" data-w="sun" aria-pressed="true">Soleil</button>
                  <button type="button" data-w="rain" aria-pressed="false">Pluie</button>
                </div>
                <p class="weather__msg" data-out="wmsg" role="status"></p>
              </div>
            </div>

            <!-- plan locator -->
            <figure class="plan">
              <svg
                viewBox="0 0 830 250"
                role="img"
                aria-labelledby="plan-t plan-d"
                class="plan__svg"
              >
                <title id="plan-t">The pond sequence of a saline, in plan</title>
                <desc id="plan-d">
                  Five pans in sequence, each smaller and shallower than the
                  last, the water darkening from green to rose as it
                  concentrates from 3.5 to 25 degrees Baumé.
                </desc>
                {
                  PANS.map((p, i) => (
                    <g
                      class="pan-g"
                      data-pan={i}
                      style={`--i:${i}`}
                      role="button"
                      tabindex="0"
                      aria-label={`${STAGES[i].name} — ${STAGES[i].be} degrés Baumé, ${STAGES[i].depth} centimètres, jour ${STAGES[i].day}`}
                    >
                      <path
                        class="pan"
                        data-pan-fill={i}
                        d={`M${p.x} ${p.y + p.skew} L${p.x + p.w} ${p.y} L${p.x + p.w - p.skew} ${p.y + p.h} L${p.x + 2} ${p.y + p.h - p.skew} Z`}
                        fill={brineColour(STAGES[i].be)}
                      />
                      <path
                        class="pan__ring"
                        data-pan-ring={i}
                        d={`M${p.x} ${p.y + p.skew} L${p.x + p.w} ${p.y} L${p.x + p.w - p.skew} ${p.y + p.h} L${p.x + 2} ${p.y + p.h - p.skew} Z`}
                        fill="none"
                      />
                    </g>
                  ))
                }
                <!-- the parcel: the water you are following, with a position.
                     Something must visibly cross the frame or the eye has
                     nothing continuous to hold. -->
                <circle class="parcel" data-parcel r="13" cx="0" cy="0" />
                <!-- trémet walkways between pans -->
                {
                  PANS.slice(0, -1).map((p, i) => (
                    <line
                      class="tremet"
                      x1={p.x + p.w}
                      y1={p.y + p.h / 2}
                      x2={PANS[i + 1].x}
                      y2={PANS[i + 1].y + PANS[i + 1].h / 2}
                    />
                  ))
                }
              </svg>
              <figcaption class="plan__cap">
                <span class="label">Vasière → cobier → fares → adernes → œillet</span>
                <span class="label plan__hint" data-hint hidden
                  >Choose a bassin to move the water to it</span
                >
              </figcaption>
            </figure>
          </div>
        </div>

        <!-- Static composition. Present in the markup, so the argument survives
             with JS off; the script hides it once the instrument is live. -->
        <div class="static" data-static>
          <div class="wrap">
            <h2 class="static__h">La cascade</h2>
            <p>
              Seawater takes about three weeks to cross a saline, climbing from
              3.5 to 25 degrees Baumé through five named ponds. It gets stronger
              and it gets shallower: forty centimetres at the tide gate, three
              in the pan where salt forms. That is why one still afternoon
              finishes a harvest and one shower of rain undoes three weeks.
            </p>
            <table class="tbl">
              <thead>
                <tr>
                  <th scope="col">Bassin</th>
                  <th scope="col">°Bé</th>
                  <th scope="col">Profondeur</th>
                  <th scope="col">Jour</th>
                </tr>
              </thead>
              <tbody>
                {
                  STAGES.map((s) => (
                    <tr>
                      <th scope="row">
                        <span
                          class="swatch"
                          style={`background:${brineColour(s.be)}`}
                          aria-hidden="true"
                        />
                        {s.name}
                      </th>
                      <td>{s.be.toFixed(1)}</td>
                      <td>{s.depth} cm</td>
                      <td>{s.day}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="static__note">
              Past {CRYSTAL_BE} °Bé the salt comes out of solution. The water
              turns rose a little before that, which is the paludier's warning
              that the pan is nearly ready.
            </p>
          </div>
        </div>
      </section>

      <!-- ---------------------------------------------- la saline -->
      <section id="saline" class="ch">
        <div class="wrap">
          <p class="measure ch__m">60<span class="measure__unit">œillets</span></p>
          <p class="pond-name">La saline</p>
          <div class="ch__body">
            <h2 class="ch__h">A marsh that is also a machine.</h2>
            <p>
              Sixty pans cut into blue clay on the marais salants of Guérande,
              worked by the Le Gall family since 1743. The whole saline runs on
              two forces and neither of them is ours: the spring tide fills it,
              and the sun empties it. There is no pump on this land and there
              never has been.
            </p>
            <p>
              What a paludier owns is not the salt. It is the grade of the clay
              floors, the width of the channels, and the judgement of when to
              let water through. A set of decisions about rate, made every day
              for three months, in a system that cannot be paused.
            </p>
          </div>
        </div>
        <figure class="plate plate--wide">
          <img
            src="/images/tremet.jpg"
            srcset="/images/tremet-800.jpg 800w, /images/tremet.jpg 1536w"
            sizes="(max-width: 900px) 100vw, 50vw"
            width="1536" height="1024" loading="lazy" decoding="async"
            alt="A narrow clay walkway running to a flat horizon between full pans, water reflecting an empty bright sky on both sides."
          />
          <figcaption class="label wrap">
            A trémet running to the horizon between full pans
          </figcaption>
        </figure>
      </section>

      <!-- ---------------------------------------------- le sel -->
      <section id="sel" class="ch">
        <div class="wrap">
          <p class="measure ch__m">2<span class="measure__unit">sels</span></p>
          <p class="pond-name">Le sel</p>
          <div class="ch__body">
            <h2 class="ch__h">Same pan. Same afternoon.<br />Different salt.</h2>
            <p>
              The difference between the two salts this saline sells is not
              grade, or grinding, or anything done afterwards. It is
              <em>where in the water each one forms</em>, and that is decided
              by the weather in the hour they appear.
            </p>
          </div>

          <div class="two">
            <figure class="salt">
              <div class="salt__dia" aria-hidden="true">
                <span class="salt__surface"></span>
                <span class="salt__floor salt__floor--on"></span>
              </div>
              <img class="salt__img" src="/images/gros-sel.jpg"
                srcset="/images/gros-sel-800.jpg 800w, /images/gros-sel.jpg 1536w"
                sizes="(max-width: 900px) 100vw, 50vw"
                width="1536" height="1024" loading="lazy" decoding="async"
                alt="A heap of wet coarse grey salt on the clay ladure, rake furrows drawn through it, crystals catching the sun." />
              <h3 class="salt__h">Gros sel</h3>
              <p class="label">On the floor · raked with the las</p>
              <p>
                Crystals form through the depth of the brine and fall. The
                paludier draws them up the slope of the pan onto the ladure,
                grey from the clay they grew against. Two hundred kilos in a
                good afternoon.
              </p>
              <p class="salt__price">
                <span class="mono">€{SALT.gros.perKg.toFixed(2)}</span> / kg
              </p>
            </figure>

            <figure class="salt">
              <div class="salt__dia" aria-hidden="true">
                <span class="salt__surface salt__surface--on"></span>
                <span class="salt__floor"></span>
              </div>
              <img class="salt__img" src="/images/fleur.jpg"
                srcset="/images/fleur-800.jpg 800w, /images/fleur.jpg 1536w"
                sizes="(max-width: 900px) 100vw, 50vw"
                width="1536" height="1024" loading="lazy" decoding="async"
                alt="A broken white lattice of fine crystals floating on the surface tension of still rose brine, raking light on every edge." />
              <h3 class="salt__h">Fleur de sel</h3>
              <p class="label">On the surface · lifted with the lousse</p>
              <p>
                On still, hot afternoons a fine crust forms on the surface
                tension and stays there. It is skimmed off the top before it
                sinks, white because it never touched the clay. A breath of wind
                and there is none at all that day.
              </p>
              <p class="salt__price">
                <span class="mono">€{SALT.fleur.perKg.toFixed(2)}</span> / kg
              </p>
            </figure>
          </div>
        </div>
      </section>

      <!-- ---------------------------------------------- le las -->
      <section id="las" class="ch ch--split">
        <figure class="plate">
          <img
            src="/images/las.jpg"
            srcset="/images/las-800.jpg 800w, /images/las.jpg 1536w"
            sizes="(max-width: 900px) 100vw, 50vw"
            width="1536" height="1024" loading="lazy" decoding="async"
            alt="A long ash-shafted wooden rake with a flat board head, resting across the clay edge of a salt pan, worn smooth by use."
          />
          <figcaption class="label">The las at rest across a pan edge</figcaption>
        </figure>
        <div class="ch__aside">
          <p class="measure ch__m">5.2<span class="measure__unit">m</span></p>
          <p class="pond-name">Le las</p>
          <h2 class="ch__h ch__h--sm">One tool, and no reason to change it.</h2>
          <p>
            A shaft of ash a little over five metres long with a flat board at
            the end. It has no moving parts, no metal, and no version number.
            The paludier stands on the trémet and draws the salt toward himself
            across seventy square metres of clay without ever stepping into the
            pan, because a footprint in a clay floor is a fault that will hold
            water wrong for years.
          </p>
          <p>
            The length is not tradition. It is the reach of a pan, and pans are
            the size they are because that is how far a person can pull.
          </p>
        </div>
      </section>

      <!-- ---------------------------------------------- les paludiers -->
      <section id="paludiers" class="ch">
        <div class="wrap">
          <p class="measure ch__m">3<span class="measure__unit">paludiers</span></p>
          <p class="pond-name">Les paludiers</p>
          <div class="ch__body">
            <h2 class="ch__h">Nobody here is watching the salt.<br />They are watching the sky.</h2>
            <p>
              The work is ninety days long and it is mostly waiting, followed
              very suddenly by not waiting. When a pan is ready it is ready for
              about four hours.
            </p>
          </div>
          <div class="three">
            <figure class="plate plate--tall">
              <img
            src="/images/paludier-1.jpg"
            srcset="/images/paludier-1-800.jpg 800w, /images/paludier-1.jpg 1536w"
            sizes="(max-width: 900px) 100vw, 50vw"
            width="1024" height="1536" loading="lazy" decoding="async"
            alt="A woman bent over the edge of a pan, drawing a fine white crust of salt from the water surface with a long wooden skimmer."
          />
              <figcaption><strong>Anne-Claire Le Gall</strong><span class="label">Fifth generation · skims the fleur</span></figcaption>
            </figure>
            <figure class="plate plate--tall">
              <img
            src="/images/paludier-2.jpg"
            srcset="/images/paludier-2-800.jpg 800w, /images/paludier-2.jpg 1536w"
            sizes="(max-width: 900px) 100vw, 50vw"
            width="1024" height="1536" loading="lazy" decoding="async"
            alt="Two salt workers on a clay walkway heaping coarse grey salt into a tall cone with long wooden rakes, caught mid-lift."
          />
              <figcaption><strong>Yann Le Gall</strong><span class="label">Her brother · cuts and repairs the clay</span></figcaption>
            </figure>
            <figure class="plate plate--tall">
              <img
            src="/images/paludier-3.jpg"
            srcset="/images/paludier-3-800.jpg 800w, /images/paludier-3.jpg 1536w"
            sizes="(max-width: 900px) 100vw, 50vw"
            width="1024" height="1536" loading="lazy" decoding="async"
            alt="A weathered man in his sixties on the clay bank at the end of a shift, squinting against the sun, dried salt on his forearms."
          />
              <figcaption><strong>Mathurin Ollivier</strong><span class="label">Forty-one seasons on this saline</span></figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ---------------------------------------------- la récolte -->
      <section id="recolte" class="ch ch--order">
        <div class="wrap">
          <p class="measure ch__m">2026<span class="measure__unit">récolte</span></p>
          <p class="pond-name">La récolte</p>
          <h2 class="ch__h">Buy from a pan, not from a brand.</h2>
          <p class="ch__lead">
            Sixty pans do not yield the same salt. Some hold heat, some sit out
            of the wind, one drains so slowly it works a fortnight later than
            the rest. This is what each of ours gave this season.
          </p>

          <table class="tbl tbl--yield">
            <thead>
              <tr>
                <th scope="col">Œillet</th>
                <th scope="col">Gros sel</th>
                <th scope="col">Fleur</th>
                <th scope="col">Le pan</th>
              </tr>
            </thead>
            <tbody>
              {
                OEILLETS.map((o) => (
                  <tr>
                    <th scope="row">
                      <span class="mono">n° {o.no}</span> {o.name}
                    </th>
                    <td class="mono">{o.gros} kg</td>
                    <td class="mono">{o.fleur} kg</td>
                    <td class="yield__note">{o.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>

          <form class="order" data-order novalidate>
            <h3 class="order__h">Commander</h3>

            <div class="field">
              <span class="label" id="lbl-type">Sel</span>
              <div class="seg" role="radiogroup" aria-labelledby="lbl-type">
                <label><input type="radio" name="type" value="gros" checked /><span>Gros sel</span></label>
                <label><input type="radio" name="type" value="fleur" /><span>Fleur de sel</span></label>
              </div>
            </div>

            <div class="field">
              <label class="label" for="f-oeillet">Œillet</label>
              <select id="f-oeillet" name="oeillet">
                {OEILLETS.map((o) => <option value={o.no}>n° {o.no} — {o.name}</option>)}
              </select>
            </div>

            <div class="field">
              <label class="label" for="f-kg">Quantité</label>
              <input id="f-kg" name="kg" type="number" min="1" step="1" value="5" inputmode="numeric" />
              <p class="err" data-err="kg" hidden></p>
            </div>

            <div class="field">
              <label class="label" for="f-nom">Nom</label>
              <input id="f-nom" name="nom" type="text" autocomplete="name" required />
              <p class="err" data-err="nom" hidden></p>
            </div>

            <div class="field">
              <label class="label" for="f-mail">Courriel</label>
              <input id="f-mail" name="mail" type="email" autocomplete="email" required />
              <p class="err" data-err="mail" hidden></p>
            </div>

            <div class="field field--wide">
              <label class="label" for="f-note">Note</label>
              <textarea id="f-note" name="note" rows="3"></textarea>
            </div>

            <div class="order__foot">
              <p class="order__total">
                <span class="label">Total</span>
                <span class="mono" data-out="total">€17.00</span>
              </p>
              <button type="submit" class="btn">Envoyer la commande</button>
            </div>

            <p class="order__fine">
              Sending opens the order in your own mail client, addressed to&#32;
              <span class="mono">recolte@kervalet.fr</span>. No card details are
              taken here, and none ever will be.
            </p>

            <p class="order__sent" data-sent hidden role="status">
              Merci. Your order is in your mail client. Send it and Anne-Claire
              will reply within two days.
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap foot__in">
        <p class="mono">Saline de Kervalet · Guérande, Loire-Atlantique</p>
        <p class="label">
          Récolte 2026 · gros sel et fleur de sel · récoltés à la main
        </p>
      </div>
    </footer>

    <script>
      import {
        STAGES,
        SALT,
        stateAt,
        brineColour,
        panBe,
        crystalAmount,
        withRain,
        fmt,
      } from "../cascade.mjs";

      const root = document.querySelector("[data-cascade]");
      if (root) {
        const PAN_PTS = JSON.parse(root.dataset.pans);
        const grid = root.querySelector(".cascade__grid");
        const stat = root.querySelector("[data-static]");
        const weather = root.querySelector("[data-weather]");
        const out = (k) => root.querySelector(`[data-out="${k}"]`);
        const els = {
          be: out("be"),
          name: out("name"),
          depth: out("depth"),
          day: out("day"),
          water: out("water"),
          crust: out("crust"),
          note: out("note"),
          wmsg: out("wmsg"),
        };

        // JS is live: the instrument replaces the static composition.
        root.dataset.live = "true";
        if (stat) stat.hidden = true;
        if (weather) weather.hidden = false;
        const hint = root.querySelector("[data-hint]");
        if (hint) hint.hidden = false;

        let raining = false;
        let p = 0;

        const maxDepth = STAGES[0].depth;
        const depth2 = root.querySelector('[data-out="depth2"]');
        const rule = root.querySelector('[data-out="rule"]');

        function paint() {
          let s = stateAt(p);
          if (raining) s = withRain(s);

          els.be.textContent = fmt.be(s.be);
          els.name.textContent = s.stage.name;
          els.depth.textContent = `${fmt.depth(s.depth)} cm`;
          els.day.textContent = fmt.day(s.day);
          // during a flood the stage note contradicts the readout, so say what
          // is actually true of the pan instead
          els.note.textContent = raining
            ? "Rainwater is sitting on top of the brine. It has to evaporate off before the pan is back where it was, and nothing can be raked until it does."
            : s.stage.note;

          const c = brineColour(s.be);
          const pct = (s.depth / maxDepth) * 100;
          els.water.style.height = `${pct}%`;
          els.water.style.background = c;
          if (rule) rule.style.bottom = `${pct}%`;
          if (depth2) depth2.textContent = `${fmt.depth(s.depth)} cm`;

          // The crust forms ON the surface, so it rides the waterline rather
          // than growing from the floor. It used to be 14% of the pan sitting
          // on a 7.5% band, which meant white swallowed the rose exactly when
          // the rose was the point.
          const cry = crystalAmount(s.be);
          els.crust.style.opacity = String(cry);
          els.crust.style.bottom = `${pct}%`;
          els.crust.style.transform = `translateY(${50 + cry * 20}%)`;
          root.classList.toggle("is-crystal", cry > 0.02);

          // The plan is a live map, not a legend: every pan is filled at the
          // concentration standing in it right now, so rain visibly drains the
          // œillet back toward the adernes instead of only moving a bar.
          // The swell travels: each pan's scale falls off with its distance
          // from the parcel, so a bulge moves down the chain rather than every
          // pan breathing at once. That is what makes it read as water
          // arriving somewhere rather than a row of blinking cells.
          const here = p * (STAGES.length - 1);
          root.querySelectorAll(".pan-g").forEach((g, i) => {
            const d = Math.abs(i - here);
            const swell = Math.max(0, 1 - d);
            const k = 1 + swell * 0.17;
            const c = PAN_PTS[i];
            g.style.transform = `translate(${c.x}px, ${c.y}px) scale(${k}) translate(${-c.x}px, ${-c.y}px)`;
            g.style.setProperty("--swell", String(swell));
          });
          root.querySelectorAll("[data-pan-fill]").forEach((f, i) => {
            f.setAttribute("fill", brineColour(panBe(i, raining)));
          });
          root.querySelectorAll("[data-pan-ring]").forEach((r, i) => {
            r.classList.toggle("is-on", i === STAGES.indexOf(s.stage));
          });

          // the parcel travels the plan continuously, so the eye always has
          // one moving thing even while the numbers step
          const parcel = root.querySelector("[data-parcel]");
          if (parcel) {
            const t = Math.min(Math.max(p, 0), 1) * (PAN_PTS.length - 1);
            const i0 = Math.min(Math.floor(t), PAN_PTS.length - 2);
            const f = t - i0;
            const a = PAN_PTS[i0], b2 = PAN_PTS[i0 + 1];
            parcel.setAttribute("cx", String(a.x + (b2.x - a.x) * f));
            parcel.setAttribute("cy", String(a.y + (b2.y - a.y) * f));
            parcel.setAttribute("fill", c);
            parcel.setAttribute("r", String(26 - 11 * p));
          }

          // a pinned frame gives no positional feedback, which is what reads
          // as "stuck". A small continuous drift restores it without giving up
          // the scrub.
          grid.style.transform = `translateY(${(0.5 - p) * 40}px)`;

          root.classList.toggle("is-rain", raining);
          els.wmsg.textContent = raining
            ? "Six jours perdus. Le bassin est noyé."
            : "";
        }

        function onScroll() {
          const r = root.getBoundingClientRect();
          const span = r.height - window.innerHeight;
          const raw = span > 0 ? Math.min(Math.max(-r.top / span, 0), 1) : 0;
          // The last fifth of the scroll holds at the œillet. The payoff frame —
          // 25 °Bé, 3 cm, day 21 — has to sit still at full height long enough
          // to be read, rather than arriving as the sticky releases.
          p = Math.min(raw / 0.8, 1);
          paint();
        }

        weather?.addEventListener("click", (e) => {
          const b = e.target.closest("[data-w]");
          if (!b) return;
          raining = b.dataset.w === "rain";
          weather.querySelectorAll("[data-w]").forEach((x) =>
            x.setAttribute("aria-pressed", String(x === b))
          );
          paint();
        });

        // keyboard path: arrow keys step the stages
        root.tabIndex = 0;
        root.addEventListener("keydown", (e) => {
          const step = 1 / (STAGES.length - 1);
          if (e.key === "ArrowRight" || e.key === "ArrowDown") {
            p = Math.min(p + step, 1);
          } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
            p = Math.max(p - step, 0);
          } else return;
          e.preventDefault();
          paint();
        });

        // A pan is a control, not a legend: choosing one moves the water to
        // it. The scroll position is the single source of truth, so this scrolls
        // rather than setting p directly — otherwise the next scroll event
        // would snap the state back and the click would look broken.
        function goToStage(i) {
          const span = root.offsetHeight - window.innerHeight;
          const frac = (i / (STAGES.length - 1)) * 0.8;
          window.scrollTo({
            top: root.offsetTop + span * frac,
            behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
              ? "auto"
              : "smooth",
          });
        }

        root.querySelectorAll(".pan-g").forEach((g, i) => {
          g.addEventListener("click", () => goToStage(i));
          g.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              goToStage(i);
            }
          });
        });

        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll);
        onScroll();
      }

      // ---------------------------------------------- la récolte
      const form = document.querySelector("[data-order]");
      if (form) {
        const kg = form.querySelector("#f-kg");
        const totalEl = form.querySelector('[data-out="total"]');
        const sent = form.querySelector("[data-sent]");
        const btn = form.querySelector(".btn");

        const salt = () =>
          SALT[form.querySelector('input[name="type"]:checked').value];

        function syncKg() {
          const s = salt();
          kg.min = String(s.min);
          kg.step = String(s.step);
          if (+kg.value < s.min) kg.value = String(s.min);
          total();
        }

        function total() {
          const s = salt();
          const n = Math.max(+kg.value || 0, 0);
          const next = `€${(n * s.perKg).toFixed(2)}`;
          if (next === totalEl.textContent) return;
          totalEl.textContent = next;
          // acknowledge the recalculation: without it the figure changes
          // silently and a buyer cannot tell their input registered
          totalEl.classList.remove("is-tick");
          void totalEl.offsetWidth;
          totalEl.classList.add("is-tick");
        }

        function fail(name, msg) {
          const input = form.querySelector(`[name="${name}"]`);
          const err = form.querySelector(`[data-err="${name}"]`);
          input.setAttribute("aria-invalid", "true");
          err.textContent = msg;
          err.hidden = false;
          return input;
        }

        function clearErrors() {
          form.querySelectorAll("[aria-invalid]").forEach((i) =>
            i.removeAttribute("aria-invalid")
          );
          form.querySelectorAll(".err").forEach((e) => {
            e.hidden = true;
            e.textContent = "";
          });
        }

        form.addEventListener("input", (e) => {
          if (e.target.name === "type") syncKg();
          else if (e.target === kg) total();
        });

        form.addEventListener("submit", (e) => {
          e.preventDefault();
          clearErrors();
          const s = salt();
          let first = null;

          if (!(+kg.value >= s.min))
            first = fail("kg", `Minimum ${s.min} ${s.unit} de ${s.label.toLowerCase()}.`);
          if (!form.querySelector("#f-nom").value.trim())
            first = fail("nom", "Il nous faut un nom.") || first;
          const mail = form.querySelector("#f-mail").value.trim();
          if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail))
            first = fail("mail", "Cette adresse ne semble pas valide.") || first;

          if (first) {
            first.focus();
            return;
          }

          // submitting
          btn.disabled = true;
          btn.textContent = "Envoi…";

          const o = form.querySelector("#f-oeillet");
          const body = [
            `${s.label} — ${kg.value} ${s.unit}`,
            `Œillet ${o.options[o.selectedIndex].text}`,
            `Total €${(kg.value * s.perKg).toFixed(2)}`,
            "",
            form.querySelector("#f-note").value,
          ].join("\n");

          setTimeout(() => {
            location.href =
              "mailto:recolte@kervalet.fr?subject=" +
              encodeURIComponent(`Commande — récolte 2026`) +
              "&body=" +
              encodeURIComponent(body);
            btn.disabled = false;
            btn.textContent = "Envoyer la commande";
            sent.hidden = false;
          }, 420);
        });

        syncKg();
      }
    </script>

    <style>
