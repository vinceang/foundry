---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Route key used to mark the current nav item. */
  nav?: string;
}

const { title, description, nav = "" } = Astro.props;

const links = [
  { href: "/houses", label: "Houses", key: "houses" },
  { href: "/frame", label: "The frame", key: "frame" },
  { href: "/rooms", label: "The rooms", key: "rooms" },
  { href: "/sumitsuke", label: "Sumitsuke", key: "sumitsuke" },
  { href: "/workshop", label: "The workshop", key: "workshop" },
  { href: "/munafuda", label: "The record", key: "munafuda" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Faustina:ital,wght@0,300..700;1,300..600&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Sans+JP:wght@300;400;500;600&family=Zen+Antique&display=swap"
    />
    <script is:inline>
      // ?nofx disables entrance motion and forces eager images — the critique
      // loop depends on it. Reduced motion gets the same treatment.
      const q = new URLSearchParams(location.search);
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      document.documentElement.classList.add("js");
      if (!q.has("nofx") && !reduced) document.documentElement.classList.add("fx");
      else document.documentElement.classList.add("nofx");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead-in wrap">
        <a class="mark" href="/" aria-label="Ibushi — home">
          <span class="mark-latin">IBUSHI</span>
          <span class="mark-jp jp" aria-hidden="true">燻</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <ul>
            {
              links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    aria-current={nav === l.key ? "page" : undefined}
                  >
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="nav-commission" href="/commission">Commission</a>
      </div>
      <hr class="snap" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <hr class="snap" />
      <div class="wrap foot-in">
        <div class="foot-col">
          <p class="foot-mark">
            IBUSHI <span class="jp" aria-hidden="true">燻</span>
          </p>
          <p class="spec gloss">
            Minka raised, moved, and revived.<br />
            Hida, Gifu Prefecture.
          </p>
        </div>
        <div class="foot-col">
          <p class="foot-h spec">The workshop</p>
          <p class="spec gloss">
            古川町 Furukawa-chō, Hida-shi, Gifu<br />
            Open to visitors by arrangement,<br />
            Tuesday to Friday.
          </p>
        </div>
        <div class="foot-col">
          <p class="foot-h spec">Correspondence</p>
          <p class="spec">
            <a href="mailto:toryo@ibushi.jp">toryo@ibushi.jp</a><br />
            <a href="/commission">Begin a commission</a><br />
            <a href="/sumitsuke">Snap a line first</a>
          </p>
        </div>
      </div>
      <p class="wrap spec gloss foot-fine">
        Ibushi is a fictional workshop built for the Foundry collection. The
        craft, the terms, and the measurements are real.
      </p>
    </footer>

    <script is:inline>
      // Entrance reveals — only when .fx is present.
      if (document.documentElement.classList.contains("fx")) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("seen");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
        );
        document.querySelectorAll(".rise").forEach((el) => io.observe(el));
      } else {
        document.querySelectorAll(".rise").forEach((el) => el.classList.add("seen"));
        document
          .querySelectorAll('img[loading="lazy"]')
          .forEach((img) => img.setAttribute("loading", "eager"));
      }
    </script>
  </body>
</html>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--washi);
  }

  .masthead-in {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 3vw, 2.75rem);
    padding-block: 1.05rem 0.95rem;
  }

  .mark {
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex: none;
  }

  .mark-latin {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.3em;
  }

  .mark-jp {
    font-size: 1.05rem;
    color: var(--sugi-deep);
  }

  .nav {
    margin-left: auto;
  }

  .nav ul {
    list-style: none;
    display: flex;
    gap: clamp(0.85rem, 2vw, 1.9rem);
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-family: var(--sans);
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--sugi-deep);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .nav a:hover {
    color: var(--susu);
    border-bottom-color: var(--okibi);
  }

  .nav a[aria-current="page"] {
    color: var(--susu);
    border-bottom-color: var(--susu);
  }

  .nav-commission {
    font-family: var(--sans);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid var(--susu);
    padding: 0.42rem 0.95rem;
    white-space: nowrap;
    flex: none;
  }

  .nav-commission:hover {
    background: var(--susu);
    color: var(--washi);
  }

  /* --- footer ---------------------------------------------------------- */

  .foot {
    margin-top: clamp(4rem, 8vw, 8rem);
  }

  .foot-in {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: clamp(1.75rem, 4vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .foot-mark {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.3em;
    margin: 0 0 0.9rem;
  }

  .foot-h {
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.6875rem;
    margin: 0 0 0.9rem;
  }

  .foot-col p {
    margin-bottom: 0;
  }

  .foot-fine {
    padding-bottom: 3rem;
    max-width: none;
    color: var(--sugi-deep);
    font-size: 0.75rem;
  }

  /* --- mobile: a smaller lamp, not a lesser brand ---------------------- */

  @media (max-width: 60rem) {
    .masthead-in {
      flex-wrap: wrap;
      row-gap: 0.65rem;
      padding-bottom: 0.75rem;
    }
    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .nav::-webkit-scrollbar {
      display: none;
    }
    .nav ul {
      padding-bottom: 0.15rem;
    }
    .nav-commission {
      margin-left: auto;
    }
  }
</style>
