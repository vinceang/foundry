    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .four-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    border-top: 1px solid var(--susu);
  }

  .four-item {
    border-bottom: 1px solid var(--susu);
