    box-shadow: 0 0.75rem 1.5rem -0.75rem rgb(0 0 0 / 0.55);
    backdrop-filter: blur(8px);
    transform: translate(1rem, -50%);
    pointer-events: none;
  }

  .lm__card.is-right {
    transform: translate(calc(-100% - 1rem), -50%);
  }

  .lm__card.is-low {
    transform: translate(1rem, -88%);
  }

  .lm__card.is-right.is-low {
    transform: translate(calc(-100% - 1rem), -88%);
  }

  .lm__cardname {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .lm__cardname span {
    color: var(--ink-3);
    font-size: 0.8em;
    margin-inline-start: 0.35em;
  }

  .lm__cardwhat {
    color: var(--ink-2);
    font-size: var(--step--1);
    margin-block: var(--sp-1) var(--sp-3);
    line-height: 1.45;
  }

  .lm__cardmeta {
    display: grid;
    gap: var(--sp-1);
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .lm__cardmeta > div {
    display: grid;
    grid-template-columns: 3.6rem 1fr;
    gap: var(--sp-3);
  }

  .lm__cardmeta dt {
    color: var(--ink-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lm__cardmeta dd {
    margin: 0;
    color: var(--ink-2);
  }

  /* ---------------------------------------------------------- controls */

  .lm__hint {
    margin-block-start: var(--sp-3);
    color: var(--ink-3);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .lm__hint kbd {
    font-family: var(--mono);
    font-size: 0.9em;
    padding: 0.1em 0.35em;
    border: 1px solid var(--rule);
    border-radius: 3px;
  }

  /* ------------------------------------------------ cooperative overlay */

  .lm__coop {
    position: absolute;
    inset: 0;
    z-index: 6;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--ground) 62%, transparent);
    backdrop-filter: blur(2px);
    opacity: 0;
    /* Never transition visibility — it is a discrete property and browsers
       disagree about when it flips. The overlay is pointer-events:none, so
       opacity alone is enough and always honest. */
    pointer-events: none;
    transition: opacity 0.22s var(--ease);
  }

  .lm__coop.is-on {
    opacity: 1;
  }

  .lm__coop span {
    font-family: var(--mono);
    font-size: var(--step-0);
    letter-spacing: 0.06em;
    color: var(--ink);
    padding: var(--sp-3) var(--sp-5);
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: color-mix(in oklab, var(--ground-2) 92%, transparent);
  }

  /* -------------------------------------------------------------- zoom */

  .lm__zoom {
    position: absolute;
    inset-block-start: var(--sp-3);
    inset-inline-end: var(--sp-3);
    z-index: 4;
    display: grid;
