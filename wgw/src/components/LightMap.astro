    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--ground);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .lm__slider input::-moz-range-thumb {
    inline-size: 1.05rem;
    block-size: 1.05rem;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--ground);
    box-shadow: 0 0 0 1px var(--accent);
