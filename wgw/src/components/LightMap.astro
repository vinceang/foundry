  .lm__now {
    min-block-size: 2.75rem;
    padding-inline: var(--sp-4);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
