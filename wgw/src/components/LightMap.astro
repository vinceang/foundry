    color: var(--ink-3);
    max-inline-size: var(--measure);
  }

  @media (min-width: 48rem) {
    .lm__head {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--sp-7);
      align-items: end;
    }

    .lm__title {
      font-size: var(--step-5);
    }
