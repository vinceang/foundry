    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }

  .lm__zoom button:hover {
    background: var(--ground-3);
    color: var(--accent);
  }

  .lm__zoom [data-zreset] {
    font-size: 0.8rem;
  }

  .lm__controls {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-block-start: var(--sp-5);
  }

  .lm__slider {
    flex: 1;
    display: block;
  }

  .lm__slider input {
    inline-size: 100%;
    block-size: 2.75rem;
    appearance: none;
    background: transparent;
    cursor: grab;
  }

  .lm__slider input:active {
    cursor: grabbing;
  }

  .lm__slider input::-webkit-slider-runnable-track {
