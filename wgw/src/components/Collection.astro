---
import meta from '../data/foundry-meta.json';

interface Site {
  slug: string;
  name: string;
  nativeName?: string;
  series: string;
  what: string;
  tagline: string;
  place: { label: string; country: string };
  signature: string;
  shipped: string;
  palette: { accent: string };
  blur: string;
  aspect: number;
  url: string;
}

interface Props {
  sites: Site[];
}

const { sites } = Astro.props;
const { series } = meta;

const seriesName = Object.fromEntries(series.map((s) => [s.id, s.name]));

// Newest first — the collection reads as a working log, not an archive.
const ordered = [...sites].sort((a, b) => (a.shipped < b.shipped ? 1 : -1));

const fmt = (d: string) =>
  new Date(d + 'T00:00:00Z').toLocaleDateString('en-GB', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<section class="col" id="collection" aria-labelledby="col-h">
  <div class="page-wide">
    <div class="marker">
      <span class="marker__n">02</span>
      <span class="marker__t">The collection</span>
    </div>

    <div class="col__head">
      <h2 id="col-h" class="col__title">What has been grown here.</h2>
      <p class="col__lede prose">
        Each one is a working site, not a mockup — brand, world, copy,
        photography and build. Open any of them and it behaves.
      </p>
    </div>

    <div class="col__filters" role="group" aria-label="Filter by quality of light">
      <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">
        All <span class="chip__n">{sites.length}</span>
      </button>
      {series.map((s) => {
        const n = sites.filter((x) => x.series === s.id).length;
        return (
          <button
            type="button"
            class="chip"
            data-filter={s.id}
            aria-pressed="false"
            style={`--chip: ${s.accent}`}
          >
            {s.name} <span class="chip__n">{n}</span>
          </button>
        );
      })}
    </div>

    <ul class="col__grid" data-grid aria-live="polite">
      {ordered.map((s, i) => (
        <li
          class:list={['card', { 'card--wide': i % 7 === 0 }]}
          data-series={s.series}
          style={`--accent: ${s.palette.accent}`}
        >
          <a class="card__a" href={`/work/${s.slug}`}>
            <div class="card__frame" style={`background-image: url(${s.blur})`}>
              <img
                class="card__img"
                src={`/collection/${s.slug}-800.webp`}
                srcset={`/collection/${s.slug}-800.webp 800w, /collection/${s.slug}-1600.webp 1600w`}
                sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 45vw, 92vw"
                width="800"
                height={Math.round(800 / s.aspect)}
                alt={`${s.name} — ${s.what}`}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <span class="card__series meta">{seriesName[s.series]}</span>
            </div>

            <div class="card__body">
              <h3 class="card__name">
                {s.name}
                {s.nativeName && <span class="card__native">{s.nativeName}</span>}
              </h3>
              <p class="card__what">{s.what}</p>
              <p class="card__tag">{s.tagline}</p>
              <dl class="card__meta meta">
                <div><dt>Place</dt><dd>{s.place.label}, {s.place.country}</dd></div>
                <div><dt>Signature</dt><dd>{s.signature}</dd></div>
                <div><dt>Built</dt><dd>{fmt(s.shipped)}</dd></div>
              </dl>
            </div>
          </a>
          <a class="card__live meta" href={s.url} target="_blank" rel="noopener">
            Visit live ↗
          </a>
        </li>
      ))}
    </ul>

    <p class="col__empty meta" data-empty hidden>Nothing in that light yet.</p>
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (grid && chips.length) {
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const want = chip.dataset.filter!;
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });

        let shown = 0;
        grid.querySelectorAll<HTMLElement>('.card').forEach((card) => {
          const match = want === 'all' || card.dataset.series === want;
          card.hidden = !match;
          if (match) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      });
    });
  }
</script>

<style>
  .col {
    padding-block: var(--sp-9);
  }

  .col__head {
    display: grid;
    gap: var(--sp-4);
    margin-block-end: var(--sp-6);
  }

  .col__title {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
  }

  .col__lede {
    color: var(--ink-2);
  }

  /* Filters scroll horizontally on a phone rather than wrapping into a
     three-line block that pushes the work off screen. */
  .col__filters {
    display: flex;
    gap: var(--sp-2);
    margin-block-end: var(--sp-6);
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    padding-block-end: var(--sp-2);
  }

  .col__filters::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: none;
    min-block-size: 2.5rem;
    padding-inline: var(--sp-4);
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 100px;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.25s var(--ease), color 0.25s var(--ease);
  }

  .chip:hover {
    border-color: var(--chip, var(--accent));
    color: var(--ink);
  }

  .chip.is-on {
    border-color: var(--chip, var(--accent));
    color: var(--ground);
    background: var(--chip, var(--accent));
  }

  .chip__n {
    opacity: 0.55;
    margin-inline-start: 0.35em;
    font-variant-numeric: tabular-nums;
  }

  .col__grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--sp-8) var(--sp-6);
    /* Wide cards would otherwise punch holes in the grid. */
    grid-auto-flow: dense;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Break the 3-up monotony: every fourth site runs wide, using the real
     aspect ratio already carried in the registry. Twenty-two identical
     crops argued the opposite of what the collection claims. */
  @media (min-width: 78rem) {
    .card--wide {
      grid-column: span 2;
    }

    .card--wide .card__frame {
      aspect-ratio: 16 / 9;
    }
  }

  .card[hidden] {
    display: none;
  }

  .card__a {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--sp-4);
    block-size: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card__frame {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    background-size: cover;
    background-position: center;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--rule-soft);
  }

  .card__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* The collection is a set of moods, not a set of screenshots. A slight
       desaturation at rest lets the accent do the talking on hover. */
    filter: saturate(0.82) contrast(1.02);
    transform: scale(1.01);
    transition: transform 1.1s var(--ease), filter 0.7s var(--ease);
  }

  .card__a:hover .card__img,
  .card__a:focus-visible .card__img {
    transform: scale(1.05);
    filter: saturate(1.05) contrast(1.03);
  }

  .card__series {
    position: absolute;
    inset-block-start: var(--sp-3);
    inset-inline-start: var(--sp-3);
    padding: 0.3rem 0.6rem;
    background: color-mix(in oklab, var(--ground) 78%, transparent);
    backdrop-filter: blur(6px);
    border-radius: 100px;
    color: var(--accent);
    font-size: 0.6875rem;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    block-size: 100%;
  }

  .card__name {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    flex-wrap: wrap;
  }

  .card__native {
    color: var(--ink-3);
    font-size: 0.72em;
  }

  .card__what {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .card__tag {
    color: var(--ink);
    border-inline-start: 2px solid var(--accent);
    padding-inline-start: var(--sp-3);
    margin-block: var(--sp-2);
    line-height: 1.45;
  }

  .card__meta {
    display: grid;
    gap: var(--sp-1);
    /* Pushes every card's hairline to the same baseline across a row,
       whatever the tagline length. */
    margin-block-start: auto;
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--rule-soft);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  .card__meta > div {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--sp-3);
  }

  .card__meta dt {
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.6875rem;
  }

  .card__meta dd {
    margin: 0;
    color: var(--ink-2);
  }

  .card__live {
    display: inline-block;
    margin-block-start: var(--sp-3);
    color: var(--ink-3);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .card__live:hover {
    color: var(--accent);
    border-block-end-color: var(--accent);
  }

  .col__empty {
    padding-block: var(--sp-7);
    text-align: center;
  }

  @media (min-width: 40rem) {
    .col__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 48rem) {
    .col__head {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-7);
      align-items: end;
    }

    .col__title {
      font-size: var(--step-5);
    }
  }

  @media (min-width: 78rem) {
    .col__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
