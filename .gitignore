# dependencies
node_modules/

# build output
dist/
build/
.next/
.astro/
.output/
.vercel/

# secrets — keys live in ~/.config/site-assets, never here, but stay defensive
.env
.env.*
*.key
tools/.cache/

# os / editor
.DS_Store
*.log

# claude code: local state stays out, but the foundry-site skill travels
# between machines — it carries build doctrine the docs/ profiles reference.
# Excluded by size: worktrees (~6GB) and the eval workspace (~420MB of
# generated site outputs), neither of which is source.
.claude/*
!.claude/agents/
!.claude/skills/
.claude/skills/*
!.claude/skills/foundry-site/
!.claude/skills/foundry-imagery/
!.claude/skills/foundry-scout/
!.claude/skills/glasshouse-register/
!.claude/skills/glasshouse-nightly/

# design-review screenshots (critique-loop artifacts, kept local)
shots/

# raw generated imagery (optimized files ship from public/)
sites/*/assets-src/
.vercel

# Rejected generation variants and superseded components, kept locally only.
wgw/assets-src/glass-b.png
wgw/src/components/Plate.astro
foundry.json.bak

# BENT scratch (raw plates are gitignored by sites/*/assets-src/)
sites/bent/dist/
sites/bent/.astro/
